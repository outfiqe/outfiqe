# Root-level values used by docker-compose.yml.
# Copy to .env and adjust. Never commit .env itself.

POSTGRES_USER=outfiqe
POSTGRES_PASSWORD=outfiqe
POSTGRES_DB=outfiqe_db
POSTGRES_PORT=5432

# apps/api integration tests run against a second database in this same
# Postgres container. See apps/api/.env.test.example for TEST_DATABASE_URL.
