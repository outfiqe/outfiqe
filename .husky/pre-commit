branch=$(git symbolic-ref --short HEAD)

if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
  echo "❌ Direct commits to '$branch' are not allowed. Create a branch first (see README: Code Quality & Commits)." >&2
  exit 1
fi

if ! echo "$branch" | grep -Eq '^(feat|fix|docs|refactor|test|chore|build|ci|perf|style|revert)/[a-z0-9]+(-[a-z0-9]+)*$'; then
  echo "❌ Branch name '$branch' doesn't match '<type>/<short-kebab-case-description>' (see README: Code Quality & Commits)." >&2
  exit 1
fi

pnpm exec lint-staged

api_docs_inputs=$(git diff --cached --name-only --diff-filter=ACMRD \
  | grep -E '^apps/api/src/(app\.ts|.*\.(routes|schemas|controller|middleware|guards)\.ts|shared/middlewares/.*\.ts|modules/.*README\.md|testing/openapi/.*\.ts)$' \
  | grep -v '\.test\.ts$' \
  || true)

if [ -n "$api_docs_inputs" ]; then
  echo "API routes changed. Regenerating apps/api/openapi/openapi.json..."
  if pnpm --filter @outfiqe/api docs:openapi > /dev/null 2>&1; then
    git add apps/api/openapi/openapi.json
    echo "✅ API docs are up to date and staged."
  else
    echo "⚠️  Couldn't regenerate the API docs (is Docker running?). Run 'pnpm --filter @outfiqe/api docs:openapi' and commit openapi.json, or CI will fail." >&2
  fi
fi
