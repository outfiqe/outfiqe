# Copy to .env and adjust. Never commit .env itself.
#
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never put secrets here - anything in this file ships to the client.

# Leave empty to use Vite's dev proxy (/api -> localhost:4000).
# Set to a full origin when the API is deployed separately,
# e.g. https://api.yourapp.com
VITE_API_URL=
