API_URL=http://localhost:4000
SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=/admin
ADMIN_ORIGIN_URL=http://localhost:5173

# Leave both unset to disable Sentry error reporting entirely.
# SENTRY_DSN=https://your-key@oXXXXXXX.ingest.us.sentry.io/XXXXXXX
# NEXT_PUBLIC_SENTRY_DSN=https://your-key@oXXXXXXX.ingest.us.sentry.io/XXXXXXX

# Cloudflare Turnstile site key (public by design, safe to expose to the browser).
# Defaults to Cloudflare's published "always passes" test site key for local dev.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
