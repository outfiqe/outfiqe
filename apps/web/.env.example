# Copy to .env and adjust. Never commit .env itself.
#
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# bundle. Neither variable below needs that prefix — both are read
# server-side only (next.config.ts rewrites, and app/layout.tsx metadata).

# The real API origin. The browser never sees this directly — it always
# calls same-origin /api/*, which next.config.ts rewrites to this origin.
# Defaults to localhost:4000 (the local API) if unset.
API_URL=http://localhost:4000

# This app's own public origin. Used for absolute URLs in metadata
# (OG images, canonical links) and sitemap.xml/robots.txt.
SITE_URL=http://localhost:3000
