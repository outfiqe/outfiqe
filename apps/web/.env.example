# Copy to .env and adjust. Never commit .env itself.
#
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.

# The real API origin. The browser never sees this directly — it always
# calls same-origin /api/*, which next.config.ts rewrites to this origin.
# Defaults to localhost:4000 (the local API) if unset. Server-only.
API_URL=http://localhost:4000

# This app's own public origin. Used for absolute URLs in metadata
# (OG images, canonical links) and sitemap.xml/robots.txt. Server-only.
SITE_URL=http://localhost:3000

# The admin panel's origin (separate app under apps/admin). Admins sign in
# here — there's no separate admin login form — and are sent straight to
# this URL on success (see getDefaultRoute.ts / safeRedirect.ts). Needs the
# NEXT_PUBLIC_ prefix: the redirect happens client-side, right after login.
NEXT_PUBLIC_ADMIN_URL=http://localhost:5173
