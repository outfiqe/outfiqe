{
  "name": "@outfiqe/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#config/*": "./src/config/*",
    "#constants/*": "./src/shared/constants/*",
    "#types/*": "./src/shared/types/*",
    "#lib/*": "./src/shared/utils/*",
    "#generated/*": "./src/generated/*",
    "#db/*": "./src/shared/db/*",
    "#middlewares/*": "./src/shared/middlewares/*",
    "#events/*": "./src/shared/events/*",
    "#storage/*": "./src/shared/storage/*",
    "#redis/*": "./src/shared/redis/*",
    "#socket/*": "./src/shared/socket/*",
    "#email-templates/*": "./src/shared/email-templates/*",
    "#scheduling/*": "./src/shared/scheduling/*",
    "#modules/*": "./src/modules/*",
    "#test/*": "./src/testing/*"
  },
  "scripts": {
    "dev": "tsx watch --import ./src/instrument.ts src/index.ts",
    "build": "tsc -b tsconfig.json",
    "start": "node --import ./dist/instrument.js dist/index.js",
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:suggestions": "tsx prisma/seedSuggestions.ts",
    "db:prune": "tsx prisma/prune.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "@outfiqe/types": "workspace:*",
    "@outfiqe/utils": "workspace:*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/node": "^10.70.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.5.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.4",
    "pg": "^8.22.0",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.4",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.1",
    "supertest": "^7.1.4",
    "tsx": "^4.23.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
