# Copy to apps/api/.env.test (gitignored) and adjust if your local Postgres
# port/credentials differ from docker-compose.yml's defaults.
#
# Points at a second database inside the same docker-compose Postgres
# container used for local dev — not the outfiqe_db used by `pnpm dev`.
# `docker compose up -d postgres redis` before running integration tests.

TEST_DATABASE_URL=postgresql://outfiqe:outfiqe@localhost:5432/outfiqe_test_db

# JWT_SECRET must satisfy env.config.ts's 32-char minimum. Not a real secret.
JWT_SECRET=test-only-secret-do-not-use-in-production-32

# Deliberately unset: GMAIL_APP_PASSWORD, ADMIN_BOOTSTRAP_* — leaving these
# unset makes sendEmail() (src/shared/utils/email.utils.ts) fall back to its
# console-stub branch instead of hitting real SMTP during tests.
