
NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://outfiqe:outfiqe@localhost:5432/outfiqe_db?schema=public"

# Generate a real one:  openssl rand -base64 48
JWT_SECRET="replace-me-must-be-at-least-32-characters"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Rejects registration/reset passwords found in the HaveIBeenPwned breach corpus.
# Set to false to disable (e.g. offline dev) — fails open on network errors either way.
PASSWORD_BREACH_CHECK_ENABLED=true

# Cloudflare Turnstile bot challenge on signup and repeated failed logins.
# Set to false to disable in local dev. Defaults to Cloudflare's published
# "always passes" test secret — replace with a real one before going live.
CAPTCHA_ENABLED=true
# TURNSTILE_SECRET_KEY=your-real-secret-key

# Google/Facebook OAuth login. Leave the placeholder defaults in local dev —
# the "Continue with Google/Facebook" buttons simply won't work until these
# are set to real values from the Google Cloud Console / Meta for Developers.
OAUTH_REDIRECT_BASE_URL=http://localhost:4000
# GOOGLE_CLIENT_ID=your-real-google-client-id
# GOOGLE_CLIENT_SECRET=your-real-google-client-secret
# FACEBOOK_APP_ID=your-real-facebook-app-id
# FACEBOOK_APP_SECRET=your-real-facebook-app-secret

# Leave GMAIL_APP_PASSWORD unset to fall back to logging emails to the console.
# Generate one at https://myaccount.google.com/apppasswords (requires 2FA).
GMAIL_USER=anjesh67890@gmail.com
# GMAIL_APP_PASSWORD=your16charapppassword


# Used to build links inside outgoing emails, and to restrict CORS to these origins.
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

STORAGE_DRIVER=local
UPLOADS_DIR=uploads
API_PUBLIC_URL=http://localhost:4000

REDIS_URL=redis://localhost:6379

# Leave unset to disable Sentry error reporting entirely.
# SENTRY_DSN=https://your-key@oXXXXXXX.ingest.us.sentry.io/XXXXXXX

# ADMIN_BOOTSTRAP_EMAIL=admin@outfiqe.com
# ADMIN_BOOTSTRAP_PASSWORD=change-this-immediately
# ADMIN_BOOTSTRAP_PHONE=9800000000
