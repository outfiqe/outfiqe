NODE_ENV=######
PORT=######
DATABASE_URL=######

JWT_SECRET=######
JWT_ACCESS_TTL=######
JWT_REFRESH_TTL=######

PASSWORD_BREACH_CHECK_ENABLED=######

CAPTCHA_ENABLED=######

OAUTH_REDIRECT_BASE_URL=######

GMAIL_USER=######

FRONTEND_URL=######

# The public, browser-facing origin for apps/admin, WITH the "/admin" base path
# (see apps/admin/vite.config.ts's `base`) — e.g. "http://localhost:3000/admin" in
# dev, where apps/web's next.config.ts rewrites() proxies /admin/* to the admin
# app's own Vite server (localhost:5173) behind the scenes. Use the proxied origin
# here, not the raw Vite port directly — the browser's session/cookies live on
# whichever origin it actually navigated to, so a link to the raw Vite port is a
# different origin and won't be "already logged in" for the person who clicks it.
ADMIN_URL=######
ALLOWED_ORIGINS=######

STORAGE_DRIVER=######
UPLOADS_DIR=######
API_PUBLIC_URL=######

# The domain CRM tenant subdomains are resolved against (e.g. "outfiqe.com" so
# "acme.outfiqe.com" resolves to the "acme" org). Defaults to "localhost" for dev,
# where "*.localhost" resolves to loopback with no DNS/hosts-file changes needed.
# Production needs a wildcard DNS record + wildcard TLS cert for this domain.
TENANT_BASE_DOMAIN=######

REDIS_URL=######

# AES-256-GCM key encrypting BankAccount.accountNumber at rest — has a dev-only
# default, but production MUST set a real 64-hex-char key: openssl rand -hex 32
BANK_ACCOUNT_ENCRYPTION_KEY=######
