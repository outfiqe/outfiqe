# Copy to .env and adjust.  Never commit .env itself.

# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database ---
# Matches the credentials in docker-compose.yml.
DATABASE_URL="postgresql://outfiqe:outfiqe@localhost:5432/outfiqe_db?schema=public"

# Optional. Prisma uses a temporary shadow database during `migrate dev` to
# detect schema drift. Only needed if your DB user cannot create databases
# (common on hosted Postgres).
# SHADOW_DATABASE_URL="postgresql://outfiqe:outfiqe@localhost:5432/outfiqe_shadow?schema=public"

# --- Auth ---
# Generate a real one:  openssl rand -base64 48
JWT_SECRET="replace-me-must-be-at-least-32-characters"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Email ---
# Leave GMAIL_APP_PASSWORD unset to fall back to logging emails to the console.
# Generate one at https://myaccount.google.com/apppasswords (requires 2FA).
GMAIL_USER=anjesh67890@gmail.com
# GMAIL_APP_PASSWORD=your16charapppassword

# --- Cross-app URLs ---
# Used to build links inside outgoing emails, and to restrict CORS to these origins.
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- File storage ---
# "local" saves uploads to disk under UPLOADS_DIR and serves them from
# API_PUBLIC_URL/uploads. Swapping providers later (e.g. S3) only means
# adding a new StorageProvider implementation and a new STORAGE_DRIVER value.
STORAGE_DRIVER=local
UPLOADS_DIR=uploads
API_PUBLIC_URL=http://localhost:4000

# --- Admin bootstrap ---
# Set all three to create the first ADMIN user on server start, only while
# no admin exists yet in this environment. Leave unset once you have one —
# further admins are invited from inside the admin panel.
# ADMIN_BOOTSTRAP_EMAIL=admin@outfiqe.com
# ADMIN_BOOTSTRAP_PASSWORD=change-this-immediately
# ADMIN_BOOTSTRAP_PHONE=9800000000
