enum BrandPayoutStatus {
  PENDING
  AVAILABLE
  WITHDRAWN
  VOIDED
}

model BrandPayout {
  id          String    @id @default(uuid()) @db.Uuid
  orderItemId String    @unique @map("order_item_id") @db.Uuid
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  brandId     String    @map("brand_id") @db.Uuid
  brand       Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  commissionRuleId String                 @map("commission_rule_id") @db.Uuid
  commissionRule   PlatformCommissionRule @relation(fields: [commissionRuleId], references: [id])

  platformCommissionTierId String?                 @map("platform_commission_tier_id") @db.Uuid
  platformCommissionTier   PlatformCommissionTier? @relation(fields: [platformCommissionTierId], references: [id], onDelete: SetNull)

  grossAmount Int @map("gross_amount")
  platformFee Int @map("platform_fee")
  gatewayFee  Int @default(0) @map("gateway_fee")
  netAmount   Int @map("net_amount")

  status BrandPayoutStatus @default(PENDING)

  availableAt         DateTime? @map("available_at")
  withdrawnAt         DateTime? @map("withdrawn_at")
  voidedReason        String?   @map("voided_reason")
