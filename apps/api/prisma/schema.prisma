enum PaymentMethod {
  COD
  ESEWA
  KHALTI
}

enum PaymentStatus {
  INITIATED
  PAID
  DUE
  FAILED
  REFUNDED
}

enum FulfilmentStatus {
  PLACED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName String  @map("full_name")
  phone    String
  address  String
  city     String
  landmark String?

  paymentMethod    PaymentMethod    @map("payment_method")
  paymentStatus    PaymentStatus    @default(INITIATED) @map("payment_status")
  fulfilmentStatus FulfilmentStatus @default(PLACED) @map("fulfilment_status")

  subtotal              Int
  deliveryFee           Int @map("delivery_fee")
  codFee                Int @default(0) @map("cod_fee")
  total                 Int
  platformDiscountTotal Int @default(0) @map("platform_discount_total")
  brandDiscountTotal    Int @default(0) @map("brand_discount_total")

  /**
   * Set when a gateway payment settles as PAID but the atomic stock
   * decrement then fails (sold out in the gap) — the payment can't be
   * undone from our side, so this flags the order for a manual refund
   * instead of silently failing. See PRD "Payment" / refund rules.
   */
  needsManualRefund Boolean   @default(false) @map("needs_manual_refund")
  deliveredAt       DateTime? @map("delivered_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items            OrderItem[]
  transactions     PaymentTransaction[]
  supportTickets   SupportTicket[]
  couponRedemption CouponRedemption?

  @@index([userId, createdAt])
  @@map("orders")
}

model OrderItem {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @map("order_id") @db.Uuid
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String      @map("product_id") @db.Uuid
  product   Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  sizeId    String      @map("size_id") @db.Uuid
  size      ProductSize @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  qty                    Int
  unitPrice              Int @map("unit_price")
  listUnitPrice          Int @map("list_unit_price")
  brandDiscountAmount    Int @default(0) @map("brand_discount_amount")
  platformDiscountAmount Int @default(0) @map("platform_discount_amount")

  /**
   * Attribution — resolved once, at order-creation time, across all three
   * click sources (tag clicks + internal/external link clicks). Exactly one
   * of attributedCreatorLookId / attributedLinkId is set, matching
   * attributionSource; attributedCreatorId is always set when there's an
   * attributed sale, regardless of which channel sourced it.
   */
  attributedCreatorId     String?           @map("attributed_creator_id") @db.Uuid
  attributedCreator       User?             @relation("AttributedOrderItems", fields: [attributedCreatorId], references: [id], onDelete: SetNull)
  attributedCreatorLookId String?           @map("attributed_creator_look_id") @db.Uuid
  attributedCreatorLook   CreatorLook?      @relation(fields: [attributedCreatorLookId], references: [id], onDelete: SetNull)
  attributedLinkId        String?           @map("attributed_link_id") @db.Uuid
  attributedLink          CreatorLink?      @relation(fields: [attributedLinkId], references: [id], onDelete: SetNull)
  attributionSource       CommissionSource? @map("attribution_source")

  commission  CreatorCommission?
  brandPayout BrandPayout?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@index([attributedCreatorId])
  @@map("order_items")
}

enum PaymentTransactionType {
  PAYMENT
  REFUND
}

enum PaymentTransactionStatus {
  INITIATED
  SUCCEEDED
  FAILED
  CANCELLED
}

model PaymentTransaction {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @map("order_id") @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  provider PaymentMethod
  type     PaymentTransactionType   @default(PAYMENT)
  status   PaymentTransactionStatus @default(INITIATED)

  // Nullable: not every attempt gets a gateway reference immediately (COD
  // never does; a wallet attempt gets one only once initiated).
  transactionRef String? @unique @map("transaction_ref")
  rawResponse    Json?   @map("raw_response")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId, status])
  @@map("payment_transactions")
}

// One row per (userId, endpoint, key) — lets checkout submission and
// payment-initiate replay the original response on a retried request
// instead of double-creating an order or a payment attempt.
model RequestIdempotency {
  id           String   @id @default(uuid()) @db.Uuid
  key          String   @map("idempotency_key")
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint     String
  statusCode   Int      @map("status_code")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([userId, endpoint, key])
  @@map("request_idempotency")
}

enum CommissionStatus {
  PENDING
  APPROVED
  AVAILABLE
  PAID
  VOIDED
}

enum CommissionSource {
  TAG_CLICK
  INTERNAL_LINK
  EXTERNAL_LINK
}

/**
 * Fixed, price-tiered commission amounts — a sold item's price is looked up
 * against these bands, never a percentage. Admin-editable; amounts are
 * snapshotted onto CreatorCommission at creation time, so editing a tier
 * here never retroactively changes an already-created commission.
 */
model CommissionTier {
  id        String   @id @default(uuid()) @db.Uuid
  minPrice  Int      @map("min_price")
  maxPrice  Int?     @map("max_price")
  amount    Int
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  commissions CreatorCommission[]

  @@map("commission_tiers")
}

model CreatorCommission {
  id          String    @id @default(uuid()) @db.Uuid
  creatorId   String    @map("creator_id") @db.Uuid
  creator     User      @relation("CreatorCommissions", fields: [creatorId], references: [id], onDelete: Cascade)
  orderItemId String    @unique @map("order_item_id") @db.Uuid
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  /**
   * Source is snapshotted explicitly (not inferred from which of
   * tagClickId/linkClickId is non-null) so the earnings ledger can render a
   * per-row badge with no extra joins.
   */
  source      CommissionSource
  tagClickId  String?              @map("tag_click_id") @db.Uuid
  tagClick    CreatorLookTagClick? @relation(fields: [tagClickId], references: [id], onDelete: SetNull)
  linkClickId String?              @map("link_click_id") @db.Uuid
  linkClick   CreatorLinkClick?    @relation(fields: [linkClickId], references: [id], onDelete: SetNull)

  tierId String         @map("tier_id") @db.Uuid
  tier   CommissionTier @relation(fields: [tierId], references: [id])
  amount Int

  status CommissionStatus @default(PENDING)

  approvedAt   DateTime? @map("approved_at")
  availableAt  DateTime? @map("available_at")
  paidAt       DateTime? @map("paid_at")
  // Cancelled/refunded/fraud-flagged orders are voided in place, not
  // deleted, so a creator's dashboard can explain a missing earning instead
  // of it silently vanishing.
  voidedReason String?   @map("voided_reason")

  createdAt DateTime @default(now()) @map("created_at")

  ledgerEntry WithdrawRequestLedgerEntry?

  @@index([creatorId, status])
  @@map("creator_commissions")
}

enum CreatorLinkType {
  INTERNAL_SINGLE_USE
  EXTERNAL_REUSABLE
}

enum CreatorLinkStatus {
  ACTIVE
  CONSUMED
  REVOKED
}

model CreatorLink {
