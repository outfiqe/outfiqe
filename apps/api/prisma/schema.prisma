  @@map("brand_payouts")
}

enum WithdrawOwnerType {
  CREATOR
  BUSINESS
}

enum WithdrawRequestStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  PAID
  REJECTED
}

model WithdrawRequest {
  id            String            @id @default(uuid()) @db.Uuid
  ownerType     WithdrawOwnerType @map("owner_type")
  requestedById String            @map("requested_by_id") @db.Uuid
  requestedBy   User              @relation("WithdrawRequestSubmitter", fields: [requestedById], references: [id], onDelete: Cascade)

  creatorId String? @map("creator_id") @db.Uuid
  creator   User?   @relation("WithdrawRequestCreatorOwner", fields: [creatorId], references: [id], onDelete: Cascade)
  brandId   String? @map("brand_id") @db.Uuid
  brand     Brand?  @relation("WithdrawRequestBrandOwner", fields: [brandId], references: [id], onDelete: Cascade)

  bankAccountId      String?           @map("bank_account_id") @db.Uuid
  bankAccount        BankAccount?      @relation(fields: [bankAccountId], references: [id])
  brandBankAccountId String?           @map("brand_bank_account_id") @db.Uuid
  brandBankAccount   BrandBankAccount? @relation(fields: [brandBankAccountId], references: [id])

  policyId String         @map("policy_id") @db.Uuid
  policy   WithdrawPolicy @relation(fields: [policyId], references: [id])

  amount          Int
  status          WithdrawRequestStatus @default(PENDING)
  rejectionReason String?               @map("rejection_reason")
  referenceNote   String?               @map("reference_note")

  requiresSecondSignOff Boolean   @default(false) @map("requires_second_sign_off")
  firstApprovedById     String?   @map("first_approved_by_id") @db.Uuid
  firstApprovedBy       User?     @relation("WithdrawRequestFirstApprover", fields: [firstApprovedById], references: [id], onDelete: SetNull)
  firstApprovedAt       DateTime? @map("first_approved_at")

  reviewedById String?   @map("reviewed_by_id") @db.Uuid
  reviewedBy   User?     @relation("WithdrawRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime? @map("reviewed_at")
  paidById     String?   @map("paid_by_id") @db.Uuid
  paidBy       User?     @relation("WithdrawRequestPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  paidAt       DateTime? @map("paid_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  ledgerEntries WithdrawRequestLedgerEntry[]

  @@index([creatorId, status])
  @@index([brandId, status])
  @@index([status, createdAt])
  @@map("withdraw_requests")
}

enum LedgerEntryKind {
  CREATOR_COMMISSION
  BRAND_PAYOUT
