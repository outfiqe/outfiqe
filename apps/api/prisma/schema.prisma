/**
 * Prisma 7: the Rust query engine is gone. The client is TypeScript + WASM
 * and a driver adapter is mandatory (see src/shared/db/prisma.ts).
 */
generator client {
  provider = "prisma-client"
  /**
   * Prisma 7 REQUIRES an explicit output. The client is no longer emitted
   * into node_modules, so it is imported from this path, not "@prisma/client".
   */
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  /**
   * No `url` here on purpose. In Prisma 7 the connection string for the CLI
   * lives in prisma.config.ts; the runtime one is passed to the adapter.
   */
}

model User {
  id                   String        @id @default(uuid()) @db.Uuid
  email                String        @unique
  name                 String
  handle               String        @unique
  phone                String?       @unique
  avatarUrl            String?       @map("avatar_url")
  passwordHash         String?       @map("password_hash")
  role                 UserRole      @default(CUSTOMER)
  isCreator            Boolean       @default(false) @map("is_creator")
  creatorStatus        CreatorStatus @default(NONE) @map("creator_status")
  creatorApprovedAt    DateTime?     @map("creator_approved_at")
  heightCm             Int?          @map("height_cm")
  showHeight           Boolean       @default(false) @map("show_height")
  emailVerified        Boolean       @default(false) @map("email_verified")
  followerCount        Int           @default(0) @map("follower_count")
  followingCount       Int           @default(0) @map("following_count")
  hideFromLeaderboards Boolean       @default(false) @map("hide_from_leaderboards")
  lastSeenAt           DateTime?     @map("last_seen_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  memberships                              BrandMembership[]
  refreshTokens                            RefreshToken[]
  reviewedApplications                     BrandApplication[]          @relation("BrandApplicationReviewer")
  approvedInvites                          BrandInvite[]               @relation("BrandInviteApprover")
  sentAdminInvites                         AdminInvite[]               @relation("AdminInviteSender")
  reviewedProducts                         Product[]                   @relation("ProductReviewer")
  createdProductDiscounts                  ProductDiscount[]           @relation("ProductDiscountCreatedBy")
  createdCoupons                           Coupon[]                    @relation("CouponCreatedBy")
  couponRedemptions                        CouponRedemption[]          @relation("CouponRedemptionUser")
  productReviews                           ProductReview[]             @relation("ProductReviewAuthor")
  productReviewHelpfulVotes                ProductReviewHelpfulVote[]
  creatorLooks                             CreatorLook[]               @relation("CreatorLooks")
  lookLikes                                CreatorLookLike[]
  lookSaves                                CreatorLookSave[]
  lookComments                             CreatorLookComment[]
  tagClicks                                CreatorLookTagClick[]
  lookViews                                CreatorLookView[]
  following                                Follow[]                    @relation("FollowerEdges")
  savedProducts                            SavedProduct[]
  cart                                     Cart?
  orders                                   Order[]
  idempotencyRequests                      RequestIdempotency[]
  attributedOrderItems                     OrderItem[]                 @relation("AttributedOrderItems")
  creatorCommissions                       CreatorCommission[]         @relation("CreatorCommissions")
  creatorLinks                             CreatorLink[]               @relation("CreatorLinks")
  creatorLinkClicks                        CreatorLinkClick[]
  crmPartnerDeals                          Deal[]                      @relation("DealPartnerCreator")
  crmActivitiesAsPartner                   CrmActivity[]               @relation("CrmActivityPartner")
  crmActivitiesAsCustomer                  CrmActivity[]               @relation("CrmActivityCustomer")
  crmTasksAsPartner                        CrmTask[]                   @relation("CrmTaskPartner")
  crmTasksAsCustomer                       CrmTask[]                   @relation("CrmTaskCustomer")
  crmTicketsAsPartner                      CrmTicket[]                 @relation("CrmTicketPartner")
  crmTicketsAsCustomer                     CrmTicket[]                 @relation("CrmTicketCustomer")
  deliveryZoneChanges                      DeliveryZoneHistory[]       @relation("DeliveryZoneChanges")
  xpTransactions                           XpTransaction[]
  progress                                 UserProgress?
  badges                                   UserBadge[]                 @relation("UserBadges")
  badgesAwarded                            UserBadge[]                 @relation("UserBadgeAwardedBy")
  notifications                            Notification[]              @relation("NotificationRecipient")
  notificationsCaused                      Notification[]              @relation("NotificationActor")
  notificationPreferences                  NotificationPreference[]
  oauthIdentities                          OAuthIdentity[]
  chatSettings                             ChatSettings?
  tastePreference                          TastePreference?
  chatBlocksInitiated                      ChatBlock[]                 @relation("ChatBlocksInitiated")
  chatBlocksReceived                       ChatBlock[]                 @relation("ChatBlocksReceived")
  conversationParticipants                 ConversationParticipant[]
  messagesSent                             Message[]                   @relation("MessageSender")
  bankAccounts                             BankAccount[]               @relation("BankAccountOwner")
  verifiedBankAccounts                     BankAccount[]               @relation("BankAccountVerifier")
  bankAccountAccessLogs                    BankAccountAccessLog[]      @relation("BankAccountAccessedBy")
  firstPayoutCrossCheckedBankAccounts      BankAccount[]               @relation("BankAccountFirstPayoutCrossChecker")
  verifiedBrandBankAccounts                BrandBankAccount[]          @relation("BrandBankAccountVerifier")
  brandBankAccountAccessLogs               BrandBankAccountAccessLog[] @relation("BrandBankAccountAccessedBy")
  firstPayoutCrossCheckedBrandBankAccounts BrandBankAccount[]          @relation("BrandBankAccountFirstPayoutCrossChecker")
  withdrawPolicyVersions                   WithdrawPolicy[]            @relation("WithdrawPolicyUpdatedBy")
  creatorWithdrawRequests                  WithdrawRequest[]           @relation("WithdrawRequestCreatorOwner")
  submittedWithdrawRequests                WithdrawRequest[]           @relation("WithdrawRequestSubmitter")
  reviewedWithdrawRequests                 WithdrawRequest[]           @relation("WithdrawRequestReviewer")
  firstApprovedWithdrawRequests            WithdrawRequest[]           @relation("WithdrawRequestFirstApprover")
  paidWithdrawRequests                     WithdrawRequest[]           @relation("WithdrawRequestPaidBy")
  platformCommissionRuleEdits              PlatformCommissionRule[]    @relation("PlatformCommissionRuleUpdatedBy")
  gatewayFeeRateEdits                      GatewayFeeRate[]            @relation("GatewayFeeRateUpdatedBy")
  createdBrandCommissionExemptions         BrandCommissionExemption[]  @relation("BrandCommissionExemptionCreatedBy")
  revokedBrandCommissionExemptions         BrandCommissionExemption[]  @relation("BrandCommissionExemptionRevokedBy")
  crmMemberships                           Membership[]
  sentOrganizationInvites                  OrganizationInvite[]        @relation("OrganizationInviteSender")
  imageProcessingAssets                    ImageProcessingAsset[]
  crmLinkedContacts                        Contact[]                   @relation("ContactLinkedUser")
  supportTicketsRequested                  SupportTicket[]             @relation("SupportTicketRequester")
  supportTicketsAssigned                   SupportTicket[]             @relation("SupportTicketAssignee")
  supportMessages                          SupportMessage[]            @relation("SupportMessageAuthor")
  pushSubscriptions                        PushSubscription[]

  @@index([isCreator, creatorStatus, followerCount])
  @@index([handle(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_handle_trgm_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_name_trgm_idx")
  @@map("users")
}

enum UserRole {
  CUSTOMER
  BRAND_OWNER
  ADMIN
}

enum CreatorStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model RefreshToken {
  id                  String    @id @default(uuid()) @db.Uuid
  tokenHash           String    @unique @map("token_hash")
  userId              String    @map("user_id") @db.Uuid
  familyId            String    @map("family_id") @db.Uuid
  expiresAt           DateTime  @map("expires_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedByTokenHash String?   @map("replaced_by_token_hash")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

model UsedPurposeToken {
  jti       String   @id
  purpose   String
  usedAt    DateTime @default(now()) @map("used_at")
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("used_purpose_tokens")
}

enum OAuthProvider {
  GOOGLE
  FACEBOOK
}

model OAuthIdentity {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        OAuthProvider
  providerUserId  String        @map("provider_user_id")
  emailAtLinkTime String        @map("email_at_link_time")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  revokedAt       DateTime?     @map("revoked_at")

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_identities")
}

model BrandInvite {
  id           String    @id @default(uuid()) @db.Uuid
  brandId      String    @map("brand_id") @db.Uuid
  brand        Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  email        String
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  acceptedAt   DateTime? @map("accepted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  approvedById String    @map("approved_by_id") @db.Uuid
  approvedBy   User      @relation("BrandInviteApprover", fields: [approvedById], references: [id])

  @@map("brand_invites")
}

model BrandApplication {
  id             String                 @id @default(uuid()) @db.Uuid
  brandName      String                 @map("brand_name")
  contactName    String                 @map("contact_name")
  email          String
  phone          String
  instagram      String
  makesOwnPieces MakesOwnPieces         @map("makes_own_pieces")
  status         BrandApplicationStatus @default(PENDING)
  reviewedAt     DateTime?              @map("reviewed_at")
  reviewedById   String?                @map("reviewed_by_id") @db.Uuid
  reviewedBy     User?                  @relation("BrandApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt      DateTime               @default(now()) @map("created_at")

  brand Brand?

  @@map("brand_applications")
}

enum BrandApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MakesOwnPieces {
  MAKES
  RESELLS
  BOTH
}

model Brand {
  id            String            @id @default(uuid()) @db.Uuid
  name          String
  contactName   String            @map("contact_name")
  email         String
  phone         String
  instagram     String
  avatarUrl     String?           @map("avatar_url")
  bannerUrl     String?           @map("banner_url")
  madeInNepal   Boolean           @default(true) @map("made_in_nepal")
  applicationId String?           @unique @map("application_id") @db.Uuid
  application   BrandApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  followerCount Int               @default(0) @map("follower_count")
  rating        Float?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  invites              BrandInvite[]
  memberships          BrandMembership[]
  products             Product[]
  sponsoredBadges      Badge[]
  bankAccounts         BrandBankAccount[]
  payouts              BrandPayout[]
  withdrawRequests     WithdrawRequest[]          @relation("WithdrawRequestBrandOwner")
  commissionExemptions BrandCommissionExemption[]
  linkedOrganization   Organization?
  supportTickets       SupportTicket[]

  @@map("brands")
}

model Product {
  id            String        @id @default(uuid()) @db.Uuid
  brandId       String        @map("brand_id") @db.Uuid
  brand         Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name          String
  price         Int
  productTypeId String        @map("product_type_id") @db.Uuid
  productType   ProductType   @relation(fields: [productTypeId], references: [id])
  categories    Category[]
  imageUrl      String?       @map("image_url")
  lowStock      Boolean       @default(false) @map("low_stock")
  status        ProductStatus @default(PENDING)
  reviewedAt    DateTime?     @map("reviewed_at")
  reviewedById  String?       @map("reviewed_by_id") @db.Uuid
  reviewedBy    User?         @relation("ProductReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  wornByCount   Int           @default(0) @map("worn_by_count")
  deletedAt     DateTime?     @map("deleted_at")

  sizes         ProductSize[]
  taggedInLooks CreatorLookProduct[]
  tagClicks     CreatorLookTagClick[]
  savedBy       SavedProduct[]
  collections   CollectionProduct[]
  images        ProductImage[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  creatorLinks  CreatorLink[]
  trendMetrics  ProductTrendMetric[]
  reviews       ProductReview[]
  discounts     ProductDiscount[]

  searchVector Unsupported("tsvector")? @map("search_vector")

  avgRating    Float? @map("avg_rating")
  reviewCount  Int    @default(0) @map("review_count")
  rating1Count Int    @default(0) @map("rating_1_count")
  rating2Count Int    @default(0) @map("rating_2_count")
  rating3Count Int    @default(0) @map("rating_3_count")
  rating4Count Int    @default(0) @map("rating_4_count")
  rating5Count Int    @default(0) @map("rating_5_count")

  @@index([deletedAt])
  @@index([brandId])
  @@index([productTypeId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@index([searchVector], type: Gin, map: "products_search_vector_idx")
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("product_images")
}

model ProductReview {
  id           String    @id @default(uuid()) @db.Uuid
  productId    String    @map("product_id") @db.Uuid
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId       String    @map("user_id") @db.Uuid
  user         User      @relation("ProductReviewAuthor", fields: [userId], references: [id], onDelete: Cascade)
  rating       Int
  title        String?
  body         String
  helpfulCount Int       @default(0) @map("helpful_count")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  images       ProductReviewImage[]
  helpfulVotes ProductReviewHelpfulVote[]

  @@unique([productId, userId])
  @@index([productId, deletedAt, createdAt])
  @@index([productId, deletedAt, rating])
  @@index([productId, deletedAt, helpfulCount])
  @@map("product_reviews")
}

model ProductReviewImage {
  id        String        @id @default(uuid()) @db.Uuid
  reviewId  String        @map("review_id") @db.Uuid
  review    ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int           @default(0) @map("sort_order")
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("product_review_images")
}

model ProductReviewHelpfulVote {
  reviewId  String        @map("review_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  review    ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now()) @map("created_at")

  @@id([reviewId, userId])
  @@map("product_review_helpful_votes")
}

model ProductTrendMetric {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  bucketStart DateTime @map("bucket_start")

  purchaseUnits Int @default(0) @map("purchase_units")
  cartAdds      Int @default(0) @map("cart_adds")
  saves         Int @default(0)
  creatorTags   Int @default(0) @map("creator_tags")
  tagClicks     Int @default(0) @map("tag_clicks")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, bucketStart])
  @@index([bucketStart])
  @@map("product_trend_metrics")
}

enum DiscountType {
  PERCENT
  FIXED
}

model ProductDiscount {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  discountType       DiscountType @map("discount_type")
  percentBasisPoints Int?         @map("percent_basis_points")
  fixedAmount        Int?         @map("fixed_amount")

  startsAt DateTime  @map("starts_at")
  endsAt   DateTime? @map("ends_at")
  isActive Boolean   @default(true) @map("is_active")

  createdById String   @map("created_by_id") @db.Uuid
  createdBy   User     @relation("ProductDiscountCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([productId, isActive, startsAt, endsAt])
  @@map("product_discounts")
}

enum CouponType {
  PERCENT
  FIXED
}

enum CouponStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum CouponEligibilityScopeType {
  BRAND
  CATEGORY
  PRODUCT
  PRODUCT_TYPE
}

enum CouponRedemptionStatus {
  CONSUMED
  RELEASED
}

model Coupon {
  id                      String       @id @default(uuid()) @db.Uuid
  code                    String       @unique
  type                    CouponType
  percentBasisPoints      Int?         @map("percent_basis_points")
  fixedAmount             Int?         @map("fixed_amount")
  maxDiscountAmount       Int?         @map("max_discount_amount")
  minSubtotal             Int          @default(0) @map("min_subtotal")
  startsAt                DateTime     @map("starts_at")
  endsAt                  DateTime?    @map("ends_at")
  status                  CouponStatus @default(ACTIVE)
  totalBudgetAmount       Int?         @map("total_budget_amount")
  spentAmount             Int          @default(0) @map("spent_amount")
  maxRedemptions          Int?         @map("max_redemptions")
  redemptionCount         Int          @default(0) @map("redemption_count")
  firstOrderOnly          Boolean      @default(false) @map("first_order_only")
  prepaidOnly             Boolean      @default(false) @map("prepaid_only")
  stacksWithBrandDiscount Boolean      @default(true) @map("stacks_with_brand_discount")

  createdById String   @map("created_by_id") @db.Uuid
  createdBy   User     @relation("CouponCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  eligibility CouponEligibility[]
  redemptions CouponRedemption[]

  @@index([status, startsAt, endsAt])
  @@map("coupons")
}

model CouponEligibility {
  id        String                     @id @default(uuid()) @db.Uuid
  couponId  String                     @map("coupon_id") @db.Uuid
  coupon    Coupon                     @relation(fields: [couponId], references: [id], onDelete: Cascade)
  scopeType CouponEligibilityScopeType @map("scope_type")
  scopeId   String                     @map("scope_id") @db.Uuid

  @@unique([couponId, scopeType, scopeId])
  @@map("coupon_eligibilities")
}

model CouponRedemption {
  id                   String                 @id @default(uuid()) @db.Uuid
  couponId             String                 @map("coupon_id") @db.Uuid
  coupon               Coupon                 @relation(fields: [couponId], references: [id])
  userId               String                 @map("user_id") @db.Uuid
  user                 User                   @relation("CouponRedemptionUser", fields: [userId], references: [id])
  orderId              String                 @unique @map("order_id") @db.Uuid
  order                Order                  @relation(fields: [orderId], references: [id])
  discountAmount       Int                    @map("discount_amount")
  platformFundedAmount Int                    @map("platform_funded_amount")
  brandFundedAmount    Int                    @default(0) @map("brand_funded_amount")
  status               CouponRedemptionStatus @default(CONSUMED)
  releasedAt           DateTime?              @map("released_at")
  releasedReason       String?                @map("released_reason")
  createdAt            DateTime               @default(now()) @map("created_at")

  @@map("coupon_redemptions")
}

model Collection {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  slug        String           @unique
  description String?
  imageUrl    String?          @map("image_url")
  status      CollectionStatus @default(DRAFT)
  sortOrder   Int              @default(0) @map("sort_order")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  products CollectionProduct[]

  @@index([status, sortOrder])
  @@map("collections")
}

enum CollectionStatus {
  DRAFT
  PUBLISHED
}

model Category {
  id        String         @id @default(uuid()) @db.Uuid
  slug      String         @unique
  name      String
  imageUrl  String?        @map("image_url")
  status    CategoryStatus @default(PUBLISHED)
  sortOrder Int            @default(0) @map("sort_order")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  products Product[]

  @@index([status, sortOrder])
  @@map("categories")
}

enum CategoryStatus {
  DRAFT
  PUBLISHED
}

model ProductType {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  label     String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products    Product[]
  sizeOptions SizeOption[]

  @@index([isActive, sortOrder])
  @@map("product_types")
}

model TastePreference {
  userId        String   @id @map("user_id") @db.Uuid
  categorySlugs String[] @map("category_slugs")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("taste_preferences")
}

model HeroSlide {
  id          String          @id @default(uuid()) @db.Uuid
  tag         String
  title       String
  description String
  imageUrl    String?         @map("image_url")
  ctaLabel    String          @map("cta_label")
  ctaHref     String          @map("cta_href")
  status      HeroSlideStatus @default(DRAFT)
  sortOrder   Int             @default(0) @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([status, sortOrder])
  @@map("hero_slides")
}

enum HeroSlideStatus {
  DRAFT
  PUBLISHED
}

model CollectionProduct {
  collectionId String     @map("collection_id") @db.Uuid
  productId    String     @map("product_id") @db.Uuid
  sortOrder    Int        @default(0) @map("sort_order")
  createdAt    DateTime   @default(now()) @map("created_at")
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@map("collection_products")
}

model ProductSize {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  inStock   Boolean  @default(true) @map("in_stock")
  stock     Int      @default(0)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, label])
  @@map("product_sizes")
}

model SizeOption {
  id            String      @id @default(uuid()) @db.Uuid
  productTypeId String      @map("product_type_id") @db.Uuid
  productType   ProductType @relation(fields: [productTypeId], references: [id], onDelete: Cascade)
  label         String
  sortOrder     Int         @default(0) @map("sort_order")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([productTypeId, label])
  @@map("size_options")
}

model CreatorLook {
  id           String    @id @default(uuid()) @db.Uuid
  creatorId    String    @map("creator_id") @db.Uuid
  creator      User      @relation("CreatorLooks", fields: [creatorId], references: [id], onDelete: Cascade)
  imageUrl     String    @map("image_url")
  caption      String?
  likeCount    Int       @default(0) @map("like_count")
  commentCount Int       @default(0) @map("comment_count")
  saveCount    Int       @default(0) @map("save_count")
  viewCount    Int       @default(0) @map("view_count")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  taggedProducts       CreatorLookProduct[]
  likes                CreatorLookLike[]
  saves                CreatorLookSave[]
