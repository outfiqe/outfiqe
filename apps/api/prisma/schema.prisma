// Prisma 7: the Rust query engine is gone. The client is TypeScript + WASM
// and a driver adapter is mandatory (see src/shared/db/prisma.ts).
generator client {
  provider = "prisma-client"
  // Prisma 7 REQUIRES an explicit output. The client is no longer emitted
  // into node_modules, so it is imported from this path, not "@prisma/client".
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // No `url` here on purpose. In Prisma 7 the connection string for the CLI
  // lives in prisma.config.ts; the runtime one is passed to the adapter.
}

model User {
  id             String        @id @default(uuid()) @db.Uuid
  email          String        @unique
  name           String
  handle         String        @unique
  phone          String        @unique
  avatarUrl      String?       @map("avatar_url")
  passwordHash   String        @map("password_hash")
  role           UserRole      @default(CUSTOMER)
  isCreator      Boolean       @default(false) @map("is_creator")
  creatorStatus  CreatorStatus @default(NONE) @map("creator_status")
  heightCm       Int?          @map("height_cm")
  emailVerified  Boolean       @default(false) @map("email_verified")
  followerCount  Int           @default(0) @map("follower_count")
  followingCount Int           @default(0) @map("following_count")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  memberships          BrandMembership[]
  refreshTokens        RefreshToken[]
  reviewedApplications BrandApplication[]    @relation("BrandApplicationReviewer")
  approvedInvites      BrandInvite[]         @relation("BrandInviteApprover")
  sentAdminInvites     AdminInvite[]         @relation("AdminInviteSender")
  reviewedProducts     Product[]             @relation("ProductReviewer")
  creatorLooks         CreatorLook[]         @relation("CreatorLooks")
  lookLikes            CreatorLookLike[]
  lookSaves            CreatorLookSave[]
  lookComments         CreatorLookComment[]
  tagClicks            CreatorLookTagClick[]
  following            Follow[]              @relation("FollowerEdges")
  savedProducts        SavedProduct[]

  @@map("users")
}

enum UserRole {
  CUSTOMER
  BRAND_OWNER
  ADMIN
}

enum CreatorStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

// One row per issued refresh token. Only the sha256 hash is stored — see
// src/shared/utils/opaque-token.utils.ts — so a DB read alone can't be
// replayed as a valid cookie value. Rotated (deleted + reissued) on every
// use, so a row's presence also means "not yet redeemed".
model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model BrandInvite {
  id           String    @id @default(uuid()) @db.Uuid
  brandId      String    @map("brand_id") @db.Uuid
  brand        Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  email        String
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  acceptedAt   DateTime? @map("accepted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  approvedById String    @map("approved_by_id") @db.Uuid
  approvedBy   User      @relation("BrandInviteApprover", fields: [approvedById], references: [id])

  @@map("brand_invites")
}

model BrandApplication {
  id             String                 @id @default(uuid()) @db.Uuid
  brandName      String                 @map("brand_name")
  contactName    String                 @map("contact_name")
  email          String
  phone          String
  instagram      String
  categories     BrandCategory[]
  makesOwnPieces MakesOwnPieces         @map("makes_own_pieces")
  status         BrandApplicationStatus @default(PENDING)
  reviewedAt     DateTime?              @map("reviewed_at")
  reviewedById   String?                @map("reviewed_by_id") @db.Uuid
  reviewedBy     User?                  @relation("BrandApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt      DateTime               @default(now()) @map("created_at")

  brand Brand?

  @@map("brand_applications")
}

enum BrandApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BrandCategory {
  STREETWEAR
  TRADITIONAL
  THRIFT
  KIDS
  FORMAL
}

enum MakesOwnPieces {
  MAKES
  RESELLS
  BOTH
}

model Brand {
  id            String            @id @default(uuid()) @db.Uuid
  name          String
  categories    BrandCategory[]
  contactName   String            @map("contact_name")
  email         String
  phone         String
  instagram     String
  avatarUrl     String?           @map("avatar_url")
  bannerUrl     String?           @map("banner_url")
  madeInNepal   Boolean           @default(true) @map("made_in_nepal")
  applicationId String?           @unique @map("application_id") @db.Uuid
  application   BrandApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  followerCount Int               @default(0) @map("follower_count")
  rating        Float?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  invites     BrandInvite[]
  memberships BrandMembership[]
  products    Product[]

  @@map("brands")
}

model Product {
  id           String        @id @default(uuid()) @db.Uuid
  brandId      String        @map("brand_id") @db.Uuid
  brand        Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name         String
  price        Int
  type         ProductType
  categories   Category[]
  imageUrl     String?       @map("image_url")
  lowStock     Boolean       @default(false) @map("low_stock")
  status       ProductStatus @default(PENDING)
  reviewedAt   DateTime?     @map("reviewed_at")
  reviewedById String?       @map("reviewed_by_id") @db.Uuid
  reviewedBy   User?         @relation("ProductReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  wornByCount  Int           @default(0) @map("worn_by_count")

  sizes         ProductSize[]
  taggedInLooks CreatorLookProduct[]
  tagClicks     CreatorLookTagClick[]
  savedBy       SavedProduct[]
  collections   CollectionProduct[]
  images        ProductImage[]

  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("product_images")
}

model Collection {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  slug        String           @unique
  description String?
  imageUrl    String?          @map("image_url")
  status      CollectionStatus @default(DRAFT)
  sortOrder   Int              @default(0) @map("sort_order")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  products CollectionProduct[]

  @@index([status, sortOrder])
  @@map("collections")
}

enum CollectionStatus {
  DRAFT
  PUBLISHED
}

model Category {
  id        String         @id @default(uuid()) @db.Uuid
  slug      String         @unique
  name      String
  imageUrl  String?        @map("image_url")
  status    CategoryStatus @default(PUBLISHED)
  sortOrder Int            @default(0) @map("sort_order")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  products Product[]

  @@index([status, sortOrder])
  @@map("categories")
}

enum CategoryStatus {
  DRAFT
  PUBLISHED
}

model HeroSlide {
  id          String          @id @default(uuid()) @db.Uuid
  tag         String
  title       String
  description String
  imageUrl    String?         @map("image_url")
  ctaLabel    String          @map("cta_label")
  ctaHref     String          @map("cta_href")
  status      HeroSlideStatus @default(DRAFT)
  sortOrder   Int             @default(0) @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([status, sortOrder])
  @@map("hero_slides")
}

enum HeroSlideStatus {
  DRAFT
  PUBLISHED
}

model CollectionProduct {
  collectionId String     @map("collection_id") @db.Uuid
  productId    String     @map("product_id") @db.Uuid
  sortOrder    Int        @default(0) @map("sort_order")
  createdAt    DateTime   @default(now()) @map("created_at")
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@map("collection_products")
}

model ProductSize {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  inStock   Boolean  @default(true) @map("in_stock")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([productId, label])
  @@map("product_sizes")
}

model CreatorLook {
  id           String    @id @default(uuid()) @db.Uuid
  creatorId    String    @map("creator_id") @db.Uuid
  creator      User      @relation("CreatorLooks", fields: [creatorId], references: [id], onDelete: Cascade)
  imageUrl     String    @map("image_url")
  caption      String?
  likeCount    Int       @default(0) @map("like_count")
  commentCount Int       @default(0) @map("comment_count")
  saveCount    Int       @default(0) @map("save_count")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  taggedProducts CreatorLookProduct[]
  likes          CreatorLookLike[]
  saves          CreatorLookSave[]
  comments       CreatorLookComment[]
  hashtags       CreatorLookHashtag[]
  tagClicks      CreatorLookTagClick[]
  images         CreatorLookImage[]

  @@index([deletedAt])
  @@index([createdAt])
  @@map("creator_looks")
}

model CreatorLookImage {
  id            String      @id @default(uuid()) @db.Uuid
  creatorLookId String      @map("creator_look_id") @db.Uuid
  creatorLook   CreatorLook @relation(fields: [creatorLookId], references: [id], onDelete: Cascade)
  url           String
  sortOrder     Int         @default(0) @map("sort_order")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("creator_look_images")
}

model CreatorLookProduct {
  id            String      @id @default(uuid()) @db.Uuid
  creatorLookId String      @map("creator_look_id") @db.Uuid
  creatorLook   CreatorLook @relation(fields: [creatorLookId], references: [id], onDelete: Cascade)
  productId     String      @map("product_id") @db.Uuid
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizeWorn      String?     @map("size_worn")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([creatorLookId, productId])
  @@map("creator_look_products")
}

model CreatorLookLike {
  creatorLookId String      @map("creator_look_id") @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at")
  creatorLook   CreatorLook @relation(fields: [creatorLookId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([creatorLookId, userId])
  @@map("creator_look_likes")
}

model CreatorLookSave {
  creatorLookId String      @map("creator_look_id") @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at")
  creatorLook   CreatorLook @relation(fields: [creatorLookId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([creatorLookId, userId])
  @@map("creator_look_saves")
}

model CreatorLookComment {
  id            String      @id @default(uuid()) @db.Uuid
  creatorLookId String      @map("creator_look_id") @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  body          String
  deletedAt     DateTime?   @map("deleted_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  creatorLook   CreatorLook @relation(fields: [creatorLookId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([creatorLookId, deletedAt])
  @@map("creator_look_comments")
}

model CreatorLookHashtag {
  creatorLookId String      @map("creator_look_id") @db.Uuid
  tag           String
  creatorLook   CreatorLook @relation(fields: [creatorLookId], references: [id], onDelete: Cascade)

  @@id([creatorLookId, tag])
  @@index([tag])
  @@map("creator_look_hashtags")
}

model CreatorLookTagClick {
  id            String                    @id @default(uuid()) @db.Uuid
  creatorLookId String                    @map("creator_look_id") @db.Uuid
  productId     String                    @map("product_id") @db.Uuid
  userId        String?                   @map("user_id") @db.Uuid
  sessionId     String                    @map("session_id")
  source        CreatorLookTagClickSource @default(FEED)
  createdAt     DateTime                  @default(now()) @map("created_at")
  creatorLook   CreatorLook               @relation(fields: [creatorLookId], references: [id], onDelete: Cascade)
  product       Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user          User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("creator_look_tag_clicks")
}

enum CreatorLookTagClickSource {
  FEED
  PRODUCT_PAGE
}

enum FollowTargetType {
  USER
  BRAND
}

model Follow {
  followerId    String           @map("follower_id") @db.Uuid
  followingType FollowTargetType @map("following_type")
  followingId   String           @map("following_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at")
  follower      User             @relation("FollowerEdges", fields: [followerId], references: [id], onDelete: Cascade)

  @@id([followerId, followingType, followingId])
  @@index([followingType, followingId])
  @@map("follows")
}

model SavedProduct {
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, productId])
  @@map("saved_products")
}

enum ProductType {
  TOPS
  BOTTOMS
  PANTS
  HEADWEAR
  OUTERWEAR
  DRESSES
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
}

model BrandMembership {
  userId  String    @map("user_id") @db.Uuid
  brandId String    @map("brand_id") @db.Uuid
  role    BrandRole @default(OWNER)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand   Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([userId, brandId])
  @@map("brand_memberships")
}

enum BrandRole {
  OWNER
  STAFF
}

model AdminInvite {
  id          String    @id @default(uuid()) @db.Uuid
  email       String
  name        String
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  invitedById String    @map("invited_by_id") @db.Uuid
  invitedBy   User      @relation("AdminInviteSender", fields: [invitedById], references: [id])

  @@map("admin_invites")
}
