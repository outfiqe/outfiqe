/**
 * Prisma 7: the Rust query engine is gone. The client is TypeScript + WASM
 * and a driver adapter is mandatory (see src/shared/db/prisma.ts).
 */
generator client {
  provider = "prisma-client"
  /**
   * Prisma 7 REQUIRES an explicit output. The client is no longer emitted
   * into node_modules, so it is imported from this path, not "@prisma/client".
   */
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  /**
   * No `url` here on purpose. In Prisma 7 the connection string for the CLI
   * lives in prisma.config.ts; the runtime one is passed to the adapter.
   */
}

model User {
  id                   String        @id @default(uuid()) @db.Uuid
  email                String        @unique
  name                 String
  handle               String        @unique
  phone                String        @unique
  avatarUrl            String?       @map("avatar_url")
  passwordHash         String        @map("password_hash")
  role                 UserRole      @default(CUSTOMER)
  isCreator            Boolean       @default(false) @map("is_creator")
  creatorStatus        CreatorStatus @default(NONE) @map("creator_status")
  heightCm             Int?          @map("height_cm")
  showHeight           Boolean       @default(false) @map("show_height")
  emailVerified        Boolean       @default(false) @map("email_verified")
  followerCount        Int           @default(0) @map("follower_count")
  followingCount       Int           @default(0) @map("following_count")
  hideFromLeaderboards Boolean       @default(false) @map("hide_from_leaderboards")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  memberships          BrandMembership[]
  refreshTokens        RefreshToken[]
  reviewedApplications BrandApplication[]    @relation("BrandApplicationReviewer")
  approvedInvites      BrandInvite[]         @relation("BrandInviteApprover")
  sentAdminInvites     AdminInvite[]         @relation("AdminInviteSender")
  reviewedProducts     Product[]             @relation("ProductReviewer")
  creatorLooks         CreatorLook[]         @relation("CreatorLooks")
  lookLikes            CreatorLookLike[]
  lookSaves            CreatorLookSave[]
  lookComments         CreatorLookComment[]
  tagClicks            CreatorLookTagClick[]
  lookViews            CreatorLookView[]
  following            Follow[]              @relation("FollowerEdges")
  savedProducts        SavedProduct[]
  cart                 Cart?
  orders               Order[]
  idempotencyRequests  RequestIdempotency[]
  attributedOrderItems OrderItem[]           @relation("AttributedOrderItems")
  creatorCommissions   CreatorCommission[]   @relation("CreatorCommissions")
  creatorLinks         CreatorLink[]         @relation("CreatorLinks")
  creatorLinkClicks    CreatorLinkClick[]
  deliveryZoneChanges  DeliveryZoneHistory[] @relation("DeliveryZoneChanges")
  xpTransactions       XpTransaction[]
  progress             UserProgress?
  badges               UserBadge[]           @relation("UserBadges")
  badgesAwarded        UserBadge[]           @relation("UserBadgeAwardedBy")

  @@index([isCreator, creatorStatus, followerCount])
  @@index([handle(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_handle_trgm_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_name_trgm_idx")
  @@map("users")
}

enum UserRole {
  CUSTOMER
  BRAND_OWNER
  ADMIN
}

enum CreatorStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

/**
 * One row per issued refresh token. Only the sha256 hash is stored — see
 * src/shared/utils/opaque-token.utils.ts — so a DB read alone can't be
 * replayed as a valid cookie value. Rotated (deleted + reissued) on every
 * use, so a row's presence also means "not yet redeemed".
 */
model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model BrandInvite {
  id           String    @id @default(uuid()) @db.Uuid
  brandId      String    @map("brand_id") @db.Uuid
  brand        Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  email        String
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  acceptedAt   DateTime? @map("accepted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  approvedById String    @map("approved_by_id") @db.Uuid
  approvedBy   User      @relation("BrandInviteApprover", fields: [approvedById], references: [id])

  @@map("brand_invites")
}

model BrandApplication {
  id             String                 @id @default(uuid()) @db.Uuid
  brandName      String                 @map("brand_name")
  contactName    String                 @map("contact_name")
  email          String
  phone          String
  instagram      String
  makesOwnPieces MakesOwnPieces         @map("makes_own_pieces")
  status         BrandApplicationStatus @default(PENDING)
  reviewedAt     DateTime?              @map("reviewed_at")
  reviewedById   String?                @map("reviewed_by_id") @db.Uuid
  reviewedBy     User?                  @relation("BrandApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt      DateTime               @default(now()) @map("created_at")

  brand Brand?

  @@map("brand_applications")
}

enum BrandApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MakesOwnPieces {
  MAKES
  RESELLS
  BOTH
}

model Brand {
  id            String            @id @default(uuid()) @db.Uuid
  name          String
  contactName   String            @map("contact_name")
  email         String
  phone         String
  instagram     String
  avatarUrl     String?           @map("avatar_url")
  bannerUrl     String?           @map("banner_url")
  madeInNepal   Boolean           @default(true) @map("made_in_nepal")
  applicationId String?           @unique @map("application_id") @db.Uuid
  application   BrandApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  followerCount Int               @default(0) @map("follower_count")
  rating        Float?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  invites     BrandInvite[]
  memberships BrandMembership[]
  products    Product[]

  @@map("brands")
}

model Product {
  id           String        @id @default(uuid()) @db.Uuid
  brandId      String        @map("brand_id") @db.Uuid
  brand        Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name         String
  price        Int
  type         ProductType
  categories   Category[]
  imageUrl     String?       @map("image_url")
  lowStock     Boolean       @default(false) @map("low_stock")
  status       ProductStatus @default(PENDING)
  reviewedAt   DateTime?     @map("reviewed_at")
  reviewedById String?       @map("reviewed_by_id") @db.Uuid
  reviewedBy   User?         @relation("ProductReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  wornByCount  Int           @default(0) @map("worn_by_count")
  deletedAt    DateTime?     @map("deleted_at")

  sizes         ProductSize[]
  taggedInLooks CreatorLookProduct[]
  tagClicks     CreatorLookTagClick[]
  savedBy       SavedProduct[]
  collections   CollectionProduct[]
  images        ProductImage[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  creatorLinks  CreatorLink[]
  trendMetrics  ProductTrendMetric[]

  searchVector Unsupported("tsvector")? @map("search_vector")

  @@index([deletedAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@index([searchVector], type: Gin, map: "products_search_vector_idx")
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("product_images")
}

model ProductTrendMetric {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  bucketStart DateTime @map("bucket_start")

  purchaseUnits Int @default(0) @map("purchase_units")
  cartAdds      Int @default(0) @map("cart_adds")
  saves         Int @default(0)
  creatorTags   Int @default(0) @map("creator_tags")
  tagClicks     Int @default(0) @map("tag_clicks")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, bucketStart])
  @@index([bucketStart])
  @@map("product_trend_metrics")
}

model Collection {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  slug        String           @unique
  description String?
  imageUrl    String?          @map("image_url")
  status      CollectionStatus @default(DRAFT)
  sortOrder   Int              @default(0) @map("sort_order")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  products CollectionProduct[]

  @@index([status, sortOrder])
  @@map("collections")
}

enum CollectionStatus {
  DRAFT
  PUBLISHED
}

model Category {
  id        String         @id @default(uuid()) @db.Uuid
  slug      String         @unique
  name      String
  imageUrl  String?        @map("image_url")
  status    CategoryStatus @default(PUBLISHED)
  sortOrder Int            @default(0) @map("sort_order")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  products Product[]

  @@index([status, sortOrder])
  @@map("categories")
}

enum CategoryStatus {
  DRAFT
  PUBLISHED
}

model HeroSlide {
  id          String          @id @default(uuid()) @db.Uuid
  tag         String
  title       String
  description String
  imageUrl    String?         @map("image_url")
  ctaLabel    String          @map("cta_label")
  ctaHref     String          @map("cta_href")
  status      HeroSlideStatus @default(DRAFT)
  sortOrder   Int             @default(0) @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([status, sortOrder])
  @@map("hero_slides")
}

enum HeroSlideStatus {
  DRAFT
  PUBLISHED
}

model CollectionProduct {
  collectionId String     @map("collection_id") @db.Uuid
  productId    String     @map("product_id") @db.Uuid
  sortOrder    Int        @default(0) @map("sort_order")
  createdAt    DateTime   @default(now()) @map("created_at")
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@map("collection_products")
}

model ProductSize {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  inStock   Boolean  @default(true) @map("in_stock")
  stock     Int      @default(0)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, label])
  @@map("product_sizes")
}

model SizeOption {
  id        String      @id @default(uuid()) @db.Uuid
  type      ProductType
  label     String
  sortOrder Int         @default(0) @map("sort_order")
  createdAt DateTime    @default(now()) @map("created_at")

  @@unique([type, label])
  @@map("size_options")
}

model CreatorLook {
  id           String    @id @default(uuid()) @db.Uuid
  creatorId    String    @map("creator_id") @db.Uuid
  creator      User      @relation("CreatorLooks", fields: [creatorId], references: [id], onDelete: Cascade)
  imageUrl     String    @map("image_url")
  caption      String?
  likeCount    Int       @default(0) @map("like_count")
  commentCount Int       @default(0) @map("comment_count")
  saveCount    Int       @default(0) @map("save_count")
  viewCount    Int       @default(0) @map("view_count")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  taggedProducts       CreatorLookProduct[]
  likes                CreatorLookLike[]
  saves                CreatorLookSave[]
  comments             CreatorLookComment[]
  hashtags             CreatorLookHashtag[]
  tagClicks            CreatorLookTagClick[]
  views                CreatorLookView[]
  images               CreatorLookImage[]
  attributedOrderItems OrderItem[]
  trendMetrics         CreatorLookTrendMetric[]

  @@index([deletedAt])
  @@index([createdAt])
  @@index([caption(ops: raw("gin_trgm_ops"))], type: Gin, map: "creator_looks_caption_trgm_idx")
  @@map("creator_looks")
}

model CreatorLookTrendMetric {
  id            String      @id @default(uuid()) @db.Uuid
  creatorLookId String      @map("creator_look_id") @db.Uuid
  creatorLook   CreatorLook @relation(fields: [creatorLookId], references: [id], onDelete: Cascade)
  bucketStart   DateTime    @map("bucket_start")

  likes     Int @default(0)
  comments  Int @default(0)
  saves     Int @default(0)
  tagClicks Int @default(0) @map("tag_clicks")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([creatorLookId, bucketStart])
  @@index([bucketStart])
  @@map("creator_look_trend_metrics")
}

model CreatorLookImage {
  id            String      @id @default(uuid()) @db.Uuid
  creatorLookId String      @map("creator_look_id") @db.Uuid
  creatorLook   CreatorLook @relation(fields: [creatorLookId], references: [id], onDelete: Cascade)
  url           String
  sortOrder     Int         @default(0) @map("sort_order")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("creator_look_images")
}

model CreatorLookProduct {
  id            String      @id @default(uuid()) @db.Uuid
  creatorLookId String      @map("creator_look_id") @db.Uuid
  creatorLook   CreatorLook @relation(fields: [creatorLookId], references: [id], onDelete: Cascade)
  productId     String      @map("product_id") @db.Uuid
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizeWorn      String?     @map("size_worn")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([creatorLookId, productId])
  @@map("creator_look_products")
}

model CreatorLookLike {
  creatorLookId String      @map("creator_look_id") @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at")
  creatorLook   CreatorLook @relation(fields: [creatorLookId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([creatorLookId, userId])
  @@map("creator_look_likes")
}

model CreatorLookSave {
  creatorLookId String      @map("creator_look_id") @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at")
  creatorLook   CreatorLook @relation(fields: [creatorLookId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([creatorLookId, userId])
  @@map("creator_look_saves")
}

model CreatorLookComment {
  id            String      @id @default(uuid()) @db.Uuid
  creatorLookId String      @map("creator_look_id") @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  body          String
  deletedAt     DateTime?   @map("deleted_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  creatorLook   CreatorLook @relation(fields: [creatorLookId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([creatorLookId, deletedAt])
  @@map("creator_look_comments")
}

model CreatorLookHashtag {
  creatorLookId String      @map("creator_look_id") @db.Uuid
  tag           String
  creatorLook   CreatorLook @relation(fields: [creatorLookId], references: [id], onDelete: Cascade)

  @@id([creatorLookId, tag])
  @@index([tag])
  @@map("creator_look_hashtags")
}

model HashtagTrendMetric {
  id          String   @id @default(uuid()) @db.Uuid
  tag         String
  bucketStart DateTime @map("bucket_start")
  postCount   Int      @default(0) @map("post_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tag, bucketStart])
  @@index([bucketStart])
  @@map("hashtag_trend_metrics")
}

model CreatorLookTagClick {
  id            String                    @id @default(uuid()) @db.Uuid
  creatorLookId String                    @map("creator_look_id") @db.Uuid
  productId     String                    @map("product_id") @db.Uuid
  userId        String?                   @map("user_id") @db.Uuid
  sessionId     String                    @map("session_id")
  source        CreatorLookTagClickSource @default(FEED)
  createdAt     DateTime                  @default(now()) @map("created_at")
  creatorLook   CreatorLook               @relation(fields: [creatorLookId], references: [id], onDelete: Cascade)
  product       Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user          User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  commissions   CreatorCommission[]

  @@index([createdAt])
  @@map("creator_look_tag_clicks")
}

enum CreatorLookTagClickSource {
  FEED
  PRODUCT_PAGE
}

model CreatorLookView {
  id            String      @id @default(uuid()) @db.Uuid
  creatorLookId String      @map("creator_look_id") @db.Uuid
  viewerId      String?     @map("viewer_id") @db.Uuid
  sessionId     String      @map("session_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  creatorLook   CreatorLook @relation(fields: [creatorLookId], references: [id], onDelete: Cascade)
  viewer        User?       @relation(fields: [viewerId], references: [id], onDelete: SetNull)

  @@unique([creatorLookId, sessionId])
  @@index([createdAt])
  @@map("creator_look_views")
}

enum FollowTargetType {
  USER
  BRAND
}

model Follow {
  followerId    String           @map("follower_id") @db.Uuid
  followingType FollowTargetType @map("following_type")
  followingId   String           @map("following_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at")
  follower      User             @relation("FollowerEdges", fields: [followerId], references: [id], onDelete: Cascade)

  @@id([followerId, followingType, followingId])
  @@index([followingType, followingId])
  @@map("follows")
}

model SavedProduct {
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, productId])
  @@index([createdAt])
  @@map("saved_products")
}

enum ProductType {
  TOPS
  BOTTOMS
  PANTS
  HEADWEAR
  OUTERWEAR
  DRESSES
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
}

model BrandMembership {
  userId  String    @map("user_id") @db.Uuid
  brandId String    @map("brand_id") @db.Uuid
  role    BrandRole @default(OWNER)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand   Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([userId, brandId])
  @@map("brand_memberships")
}

enum BrandRole {
  OWNER
  STAFF
}

model AdminInvite {
  id          String    @id @default(uuid()) @db.Uuid
  email       String
  name        String
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  invitedById String    @map("invited_by_id") @db.Uuid
  invitedBy   User      @relation("AdminInviteSender", fields: [invitedById], references: [id])

  @@map("admin_invites")
}

// ---------------------------------------------------------------------------
// Cart
// ---------------------------------------------------------------------------

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String      @id @default(uuid()) @db.Uuid
  cartId    String      @map("cart_id") @db.Uuid
  cart      Cart        @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String      @map("product_id") @db.Uuid
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizeId    String      @map("size_id") @db.Uuid
  size      ProductSize @relation(fields: [sizeId], references: [id], onDelete: Cascade)
  qty       Int         @default(1)
  createdAt DateTime    @default(now()) @map("created_at")

  @@unique([cartId, sizeId])
  @@index([createdAt])
  @@map("cart_items")
}

enum PaymentMethod {
  COD
  ESEWA
  KHALTI
}

enum PaymentStatus {
  INITIATED
  PAID
  DUE
  FAILED
  REFUNDED
}

enum FulfilmentStatus {
  PLACED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName String  @map("full_name")
  phone    String
  address  String
  city     String
  landmark String?

  paymentMethod    PaymentMethod    @map("payment_method")
  paymentStatus    PaymentStatus    @default(INITIATED) @map("payment_status")
  fulfilmentStatus FulfilmentStatus @default(PLACED) @map("fulfilment_status")

  subtotal    Int
  deliveryFee Int @map("delivery_fee")
  codFee      Int @default(0) @map("cod_fee")
  total       Int

  /**
   * Set when a gateway payment settles as PAID but the atomic stock
   * decrement then fails (sold out in the gap) — the payment can't be
   * undone from our side, so this flags the order for a manual refund
   * instead of silently failing. See PRD "Payment" / refund rules.
   */
  needsManualRefund Boolean   @default(false) @map("needs_manual_refund")
  deliveredAt       DateTime? @map("delivered_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items        OrderItem[]
  transactions PaymentTransaction[]

  @@index([userId, createdAt])
  @@map("orders")
}

model OrderItem {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @map("order_id") @db.Uuid
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String      @map("product_id") @db.Uuid
  product   Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  sizeId    String      @map("size_id") @db.Uuid
  size      ProductSize @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  qty       Int
  unitPrice Int         @map("unit_price")

  /**
   * Attribution — resolved once, at order-creation time, across all three
   * click sources (tag clicks + internal/external link clicks). Exactly one
   * of attributedCreatorLookId / attributedLinkId is set, matching
   * attributionSource; attributedCreatorId is always set when there's an
   * attributed sale, regardless of which channel sourced it.
   */
  attributedCreatorId     String?           @map("attributed_creator_id") @db.Uuid
  attributedCreator       User?             @relation("AttributedOrderItems", fields: [attributedCreatorId], references: [id], onDelete: SetNull)
  attributedCreatorLookId String?           @map("attributed_creator_look_id") @db.Uuid
  attributedCreatorLook   CreatorLook?      @relation(fields: [attributedCreatorLookId], references: [id], onDelete: SetNull)
  attributedLinkId        String?           @map("attributed_link_id") @db.Uuid
  attributedLink          CreatorLink?      @relation(fields: [attributedLinkId], references: [id], onDelete: SetNull)
  attributionSource       CommissionSource? @map("attribution_source")

  commission CreatorCommission?

  createdAt DateTime @default(now()) @map("created_at")

  @@map("order_items")
}

enum PaymentTransactionType {
  PAYMENT
  REFUND
}

enum PaymentTransactionStatus {
  INITIATED
  SUCCEEDED
  FAILED
  CANCELLED
}

model PaymentTransaction {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @map("order_id") @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  provider PaymentMethod
  type     PaymentTransactionType   @default(PAYMENT)
  status   PaymentTransactionStatus @default(INITIATED)

  // Nullable: not every attempt gets a gateway reference immediately (COD
  // never does; a wallet attempt gets one only once initiated).
  transactionRef String? @unique @map("transaction_ref")
  rawResponse    Json?   @map("raw_response")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId, status])
  @@map("payment_transactions")
}

// One row per (userId, endpoint, key) — lets checkout submission and
// payment-initiate replay the original response on a retried request
// instead of double-creating an order or a payment attempt.
model RequestIdempotency {
  id           String   @id @default(uuid()) @db.Uuid
  key          String   @map("idempotency_key")
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint     String
  statusCode   Int      @map("status_code")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([userId, endpoint, key])
  @@map("request_idempotency")
}

enum CommissionStatus {
  PENDING
  APPROVED
  AVAILABLE
  PAID
  VOIDED
}

enum CommissionSource {
  TAG_CLICK
  INTERNAL_LINK
  EXTERNAL_LINK
}

/**
 * Fixed, price-tiered commission amounts — a sold item's price is looked up
 * against these bands, never a percentage. Admin-editable; amounts are
 * snapshotted onto CreatorCommission at creation time, so editing a tier
 * here never retroactively changes an already-created commission.
 */
model CommissionTier {
  id        String   @id @default(uuid()) @db.Uuid
  minPrice  Int      @map("min_price")
  maxPrice  Int?     @map("max_price")
  amount    Int
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  commissions CreatorCommission[]

  @@map("commission_tiers")
}

model CreatorCommission {
  id          String    @id @default(uuid()) @db.Uuid
  creatorId   String    @map("creator_id") @db.Uuid
  creator     User      @relation("CreatorCommissions", fields: [creatorId], references: [id], onDelete: Cascade)
  orderItemId String    @unique @map("order_item_id") @db.Uuid
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  /**
   * Source is snapshotted explicitly (not inferred from which of
   * tagClickId/linkClickId is non-null) so the earnings ledger can render a
   * per-row badge with no extra joins.
   */
  source      CommissionSource
  tagClickId  String?              @map("tag_click_id") @db.Uuid
  tagClick    CreatorLookTagClick? @relation(fields: [tagClickId], references: [id], onDelete: SetNull)
  linkClickId String?              @map("link_click_id") @db.Uuid
  linkClick   CreatorLinkClick?    @relation(fields: [linkClickId], references: [id], onDelete: SetNull)

  tierId String         @map("tier_id") @db.Uuid
  tier   CommissionTier @relation(fields: [tierId], references: [id])
  amount Int

  status CommissionStatus @default(PENDING)

  approvedAt   DateTime? @map("approved_at")
  availableAt  DateTime? @map("available_at")
  paidAt       DateTime? @map("paid_at")
  // Cancelled/refunded/fraud-flagged orders are voided in place, not
  // deleted, so a creator's dashboard can explain a missing earning instead
  // of it silently vanishing.
  voidedReason String?   @map("voided_reason")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([creatorId, status])
  @@map("creator_commissions")
}

enum CreatorLinkType {
  INTERNAL_SINGLE_USE
  EXTERNAL_REUSABLE
}

enum CreatorLinkStatus {
  ACTIVE
  CONSUMED
  REVOKED
}

model CreatorLink {
  id         String            @id @default(uuid()) @db.Uuid
  creatorId  String            @map("creator_id") @db.Uuid
  creator    User              @relation("CreatorLinks", fields: [creatorId], references: [id], onDelete: Cascade)
  productId  String?           @map("product_id") @db.Uuid
  product    Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  token      String            @unique
  type       CreatorLinkType
  status     CreatorLinkStatus @default(ACTIVE)
  consumedAt DateTime?         @map("consumed_at")

  createdAt DateTime @default(now()) @map("created_at")

  clicks     CreatorLinkClick[]
  orderItems OrderItem[]

  @@index([creatorId])
  @@map("creator_links")
}

model CreatorLinkClick {
  id        String      @id @default(uuid()) @db.Uuid
  linkId    String      @map("link_id") @db.Uuid
  link      CreatorLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  userId    String?     @map("user_id") @db.Uuid
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String      @map("session_id")

  createdAt DateTime @default(now()) @map("created_at")

  commissions CreatorCommission[]

  @@index([linkId])
  @@map("creator_link_clicks")
}

model DeliveryZone {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String
  isDefault             Boolean  @default(false) @map("is_default")
  standardDeliveryFee   Int      @map("standard_delivery_fee")
  freeDeliveryThreshold Int      @map("free_delivery_threshold")
  codHandlingFee        Int      @map("cod_handling_fee")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  cities  DeliveryZoneCity[]
  history DeliveryZoneHistory[]

  @@map("delivery_zones")
}

model DeliveryZoneCity {
  id             String       @id @default(uuid()) @db.Uuid
  zoneId         String       @map("zone_id") @db.Uuid
  zone           DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  city           String
  cityNormalized String       @map("city_normalized")

  @@unique([cityNormalized])
  @@index([zoneId])
  @@map("delivery_zone_cities")
}

model DeliveryZoneHistory {
  id     String       @id @default(uuid()) @db.Uuid
  zoneId String       @map("zone_id") @db.Uuid
  zone   DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  changedById String @map("changed_by_id") @db.Uuid
  changedBy   User   @relation("DeliveryZoneChanges", fields: [changedById], references: [id])

  oldValues Json @map("old_values")
  newValues Json @map("new_values")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([zoneId, createdAt])
  @@map("delivery_zone_history")
}

// ---------------------------------------------------------------------------
// Gamification — XP, Levels, Achievements, Badges
// See apps/api/src/modules/{xp,achievements,badges}/README.md for the engine
// design; this block is data model only.
// ---------------------------------------------------------------------------

model Level {
  id         String   @id @default(uuid()) @db.Uuid
  level      Int      @unique
  name       String
  requiredXp Int      @map("required_xp")
  icon       String?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  usersAtLevel UserProgress[]

  @@index([isActive, requiredXp])
  @@map("levels")
}

model UserProgress {
  userId         String   @id @map("user_id") @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalXp        Int      @default(0) @map("total_xp")
  currentLevelId String   @map("current_level_id") @db.Uuid
  currentLevel   Level    @relation(fields: [currentLevelId], references: [id])
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([totalXp])
  @@map("user_progress")
}

enum XpActivityType {
  LOOK_CREATED
  LOOK_LIKE_RECEIVED
  LOOK_COMMENT_RECEIVED
  LOOK_COMMENTED
  LOOK_SAVED
  USER_FOLLOWED
  PRODUCT_PURCHASED
  SALE_GENERATED
  PRODUCT_TAGGED
  FOLLOWER_MILESTONE
  ACHIEVEMENT_UNLOCKED
  ADMIN_ADJUSTMENT
}

enum XpTransactionStatus {
  APPLIED
  REVERSED
}

/**
 * Append-only audit ledger (spec 07). Every XP change — automatic or manual —
 * gets a row here; UserProgress.totalXp is the denormalized running sum kept
 * in sync at write time, never recomputed by summing this table on read.
 */
model XpTransaction {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityType    XpActivityType      @map("activity_type")
  amount          Int
  relatedEntityId String?             @map("related_entity_id") @db.Uuid
  source          String
  metadata        Json?
  status          XpTransactionStatus @default(APPLIED)
  createdAt       DateTime            @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, activityType, relatedEntityId])
  @@map("xp_transactions")
}

/**
 * Spec 40 — admin-tunable per-activity XP economy. The anti-abuse knobs
 * (spec 06) live here per-activity rather than a separate table: a daily cap,
 * a cooldown, and a max-times-per-entity are all scoped to one activity type.
 */
model ActivityXpConfig {
  activityType    XpActivityType @id @map("activity_type")
  enabled         Boolean        @default(true)
  xpAmount        Int            @map("xp_amount")
  dailyLimit      Int?           @map("daily_limit")
  cooldownSeconds Int?           @map("cooldown_seconds")
  maxPerEntity    Int?           @map("max_per_entity")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@map("activity_xp_configs")
}

enum BadgeCategory {
  BEGINNER
  CREATOR
  COMMUNITY
  ENGAGEMENT
  COMMERCE
  SPECIAL
}

enum BadgeRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  EXCLUSIVE
}

/**
 * designConfig/requirementConfig are validated at the service boundary via a
 * Zod schema — see badges.schemas.ts — never trusted as `any` past that point.
 */
model Badge {
  id              String        @id @default(uuid()) @db.Uuid
  name            String
  description     String
  category        BadgeCategory
  rarity          BadgeRarity
  icon            String
  designConfig    Json          @map("design_config")
  xpReward        Int           @default(0) @map("xp_reward")
  isPermanent     Boolean       @default(true) @map("is_permanent")
  isDynamic       Boolean       @default(false) @map("is_dynamic")
  isPublic        Boolean       @default(true) @map("is_public")
  isActive        Boolean       @default(true) @map("is_active")
  assignmentLimit Int?          @map("assignment_limit")
  assignmentCount Int           @default(0) @map("assignment_count")
  isTitleEligible Boolean       @default(false) @map("is_title_eligible")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  achievement Achievement?
  userBadges  UserBadge[]

  @@index([category, isActive])
  @@map("badges")
}

enum AchievementRequirementType {
  MILESTONE
  ACTIVITY
  ENGAGEMENT
  COMMERCE
  COMMUNITY
  LEVEL
  SPECIAL
  ADMIN_AWARD
}

model Achievement {
  id                String                     @id @default(uuid()) @db.Uuid
  badgeId           String                     @unique @map("badge_id") @db.Uuid
  badge             Badge                      @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  name              String
  description       String
  requirementType   AchievementRequirementType @map("requirement_type")
  requirementConfig Json                       @map("requirement_config")
  isActive          Boolean                    @default(true) @map("is_active")
  activeFrom        DateTime?                  @map("active_from")
  activeUntil       DateTime?                  @map("active_until")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  challenge Challenge?

  @@index([isActive])
  @@map("achievements")
}

model Challenge {
  id             String      @id @default(uuid()) @db.Uuid
  achievementId  String      @unique @map("achievement_id") @db.Uuid
  achievement    Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  name           String
  description    String
  bannerImageUrl String?     @map("banner_image_url")
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("challenges")
}

enum CreatorLeaderboardCategory {
  TOP_XP
  TOP_CREATOR
  MOST_LIKES
  MOST_ENGAGED
  TOP_SELLER
  RISING_CREATOR
  MOST_ACHIEVEMENTS
}

model CreatorLeaderboardCategoryConfig {
  category  CreatorLeaderboardCategory @id
  enabled   Boolean                    @default(true)
  createdAt DateTime                   @default(now()) @map("created_at")
  updatedAt DateTime                   @updatedAt @map("updated_at")

  @@map("creator_leaderboard_category_configs")
}

/**
 * awardedBy null = engine-awarded (achievement satisfied); set = admin
 * manual award (spec 31). Removal (spec 33) is `isDisplayed: false` +
 * `removedReason`/`removedAt`/`removedById` set, never a hard delete — same
 * "void, don't delete" convention as CreatorCommission/CommissionTier.
 */
model UserBadge {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  user          User      @relation("UserBadges", fields: [userId], references: [id], onDelete: Cascade)
  badgeId       String    @map("badge_id") @db.Uuid
  badge         Badge     @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedById   String?   @map("awarded_by_id") @db.Uuid
  awardedBy     User?     @relation("UserBadgeAwardedBy", fields: [awardedById], references: [id], onDelete: SetNull)
  awardReason   String?   @map("award_reason")
  isDisplayed   Boolean   @default(true) @map("is_displayed")
  isFeatured    Boolean   @default(false) @map("is_featured")
  isTitle       Boolean   @default(false) @map("is_title")
  displayOrder  Int       @default(0) @map("display_order")
  removedAt     DateTime? @map("removed_at")
  removedReason String?   @map("removed_reason")
  unlockedAt    DateTime  @default(now()) @map("unlocked_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([userId, badgeId])
  @@index([userId, isDisplayed])
  @@map("user_badges")
}
