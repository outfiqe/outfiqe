model Organization {
  id                     String    @id @default(uuid()) @db.Uuid
  name                   String
  subdomain              String    @unique
  isPlatformOrg          Boolean   @default(false) @map("is_platform_org")
  plan                   String    @default("trial")
  trialEndsAt            DateTime? @map("trial_ends_at")
  superAdminMembershipId String?   @unique @map("super_admin_membership_id") @db.Uuid
  linkedBrandId          String?   @unique @map("linked_brand_id") @db.Uuid
  linkedBrand            Brand?    @relation(fields: [linkedBrandId], references: [id], onDelete: SetNull)
  contactCount           Int       @default(0) @map("contact_count")
  dealCount              Int       @default(0) @map("deal_count")
  ticketCount            Int       @default(0) @map("ticket_count")
  activityCount          Int       @default(0) @map("activity_count")
  lastCrmActivityAt      DateTime? @map("last_crm_activity_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  memberships               Membership[]
  roles                     Role[]
  invites                   OrganizationInvite[]
  ownershipTransferRequests OwnershipTransferRequest[]
  subscription              Subscription?
  pipelineStages            PipelineStage[]
  deals                     Deal[]
  crmActivities             CrmActivity[]
  crmTasks                  CrmTask[]
  crmTickets                CrmTicket[]
  crmAuditLogs              CrmAuditLog[]
  contacts                  Contact[]
  activityRollups           OrgActivityRollup[]
  featureOverrides          TenantFeatureOverride[]
  impersonationSessions     ImpersonationSession[]

  @@map("organizations")
}

model PipelineStage {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  sortOrder      Int          @map("sort_order")
  isWon          Boolean      @default(false) @map("is_won")
  isLost         Boolean      @default(false) @map("is_lost")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  deals Deal[]

  @@unique([organizationId, name])
  @@index([organizationId, sortOrder])
  @@map("pipeline_stages")
}

enum DealStatus {
  OPEN
  WON
  LOST
}

model Deal {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stageId           String        @map("stage_id") @db.Uuid
  stage             PipelineStage @relation(fields: [stageId], references: [id])
  title             String
  value             Int           @default(0)
  currency          String        @default("NPR")
  expectedCloseDate DateTime?     @map("expected_close_date")
  ownerMembershipId String?       @map("owner_membership_id") @db.Uuid
  ownerMembership   Membership?   @relation("DealOwnerMembership", fields: [ownerMembershipId], references: [id], onDelete: SetNull)
  partnerCreatorId  String        @map("partner_creator_id") @db.Uuid
  partnerCreator    User          @relation("DealPartnerCreator", fields: [partnerCreatorId], references: [id], onDelete: Cascade)
  status            DealStatus    @default(OPEN)
  closedAt          DateTime?     @map("closed_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  activities CrmActivity[]
  tasks      CrmTask[]

  @@index([organizationId, stageId])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "deals_title_trgm_idx")
  @@map("deals")
}

enum CrmActivityType {
  NOTE
  CALL
  MESSAGE
  EMAIL
}

enum CrmTicketType {
  COMPLAINT
  REQUEST
}

enum CrmTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model CrmTicket {
  id                    String          @id @default(uuid()) @db.Uuid
  organizationId        String          @map("organization_id") @db.Uuid
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type                  CrmTicketType
  status                CrmTicketStatus @default(OPEN)
  title                 String
  description           String
  partnerCreatorId      String?         @map("partner_creator_id") @db.Uuid
  partnerCreator        User?           @relation("CrmTicketPartner", fields: [partnerCreatorId], references: [id], onDelete: Cascade)
  customerUserId        String?         @map("customer_user_id") @db.Uuid
  customerUser          User?           @relation("CrmTicketCustomer", fields: [customerUserId], references: [id], onDelete: Cascade)
  assigneeMembershipId  String?         @map("assignee_membership_id") @db.Uuid
  assigneeMembership    Membership?     @relation("CrmTicketAssignee", fields: [assigneeMembershipId], references: [id], onDelete: SetNull)
  createdByMembershipId String?         @map("created_by_membership_id") @db.Uuid
  createdByMembership   Membership?     @relation("CrmTicketCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  resolvedAt            DateTime?       @map("resolved_at")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  comments CrmTicketComment[]

  @@index([organizationId, status, createdAt])
  @@index([organizationId, assigneeMembershipId])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "crm_tickets_title_trgm_idx")
  @@map("crm_tickets")
}

model CrmTicketComment {
  id                 String      @id @default(uuid()) @db.Uuid
  ticketId           String      @map("ticket_id") @db.Uuid
  ticket             CrmTicket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorMembershipId String?     @map("author_membership_id") @db.Uuid
  authorMembership   Membership? @relation("CrmTicketCommentAuthor", fields: [authorMembershipId], references: [id], onDelete: SetNull)
  body               String
  createdAt          DateTime    @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@map("crm_ticket_comments")
}

enum CrmTaskStatus {
  OPEN
  DONE
}

model CrmActivity {
  id                 String          @id @default(uuid()) @db.Uuid
  organizationId     String          @map("organization_id") @db.Uuid
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type               CrmActivityType
  body               String
  occurredAt         DateTime        @default(now()) @map("occurred_at")
  authorMembershipId String?         @map("author_membership_id") @db.Uuid
  authorMembership   Membership?     @relation("CrmActivityAuthor", fields: [authorMembershipId], references: [id], onDelete: SetNull)
  partnerCreatorId   String?         @map("partner_creator_id") @db.Uuid
  partnerCreator     User?           @relation("CrmActivityPartner", fields: [partnerCreatorId], references: [id], onDelete: Cascade)
  customerUserId     String?         @map("customer_user_id") @db.Uuid
  customerUser       User?           @relation("CrmActivityCustomer", fields: [customerUserId], references: [id], onDelete: Cascade)
  dealId             String?         @map("deal_id") @db.Uuid
  deal               Deal?           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@index([organizationId, partnerCreatorId, occurredAt])
  @@index([organizationId, customerUserId, occurredAt])
  @@index([organizationId, dealId, occurredAt])
  @@map("crm_activities")
}

model CrmTask {
  id                    String        @id @default(uuid()) @db.Uuid
  organizationId        String        @map("organization_id") @db.Uuid
  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title                 String
  description           String?
  dueAt                 DateTime      @map("due_at")
  status                CrmTaskStatus @default(OPEN)
  assigneeMembershipId  String        @map("assignee_membership_id") @db.Uuid
  assigneeMembership    Membership    @relation("CrmTaskAssignee", fields: [assigneeMembershipId], references: [id], onDelete: Cascade)
  createdByMembershipId String?       @map("created_by_membership_id") @db.Uuid
  createdByMembership   Membership?   @relation("CrmTaskCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  partnerCreatorId      String?       @map("partner_creator_id") @db.Uuid
  partnerCreator        User?         @relation("CrmTaskPartner", fields: [partnerCreatorId], references: [id], onDelete: Cascade)
  customerUserId        String?       @map("customer_user_id") @db.Uuid
  customerUser          User?         @relation("CrmTaskCustomer", fields: [customerUserId], references: [id], onDelete: Cascade)
  dealId                String?       @map("deal_id") @db.Uuid
  deal                  Deal?         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  completedAt           DateTime?     @map("completed_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  @@index([organizationId, assigneeMembershipId, dueAt])
  @@index([organizationId, status, dueAt])
  @@map("crm_tasks")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum SubscriptionInvoiceStatus {
  OPEN
  PAID
  VOID
}

enum CrmBillingProvider {
  ESEWA
  KHALTI
}

model Subscription {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @unique @map("organization_id") @db.Uuid
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan              String
  status            SubscriptionStatus @default(TRIALING)
  seats             Int                @default(1)
  currentPeriodEnd  DateTime           @map("current_period_end")
  cancelAtPeriodEnd Boolean            @default(false) @map("cancel_at_period_end")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  invoices SubscriptionInvoice[]

  @@map("subscriptions")
}

model SubscriptionInvoice {
  id             String                    @id @default(uuid()) @db.Uuid
  subscriptionId String                    @map("subscription_id") @db.Uuid
  subscription   Subscription              @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  plan           String
  seats          Int
  amount         Int
  status         SubscriptionInvoiceStatus @default(OPEN)
  periodStart    DateTime                  @map("period_start")
  periodEnd      DateTime                  @map("period_end")
  provider       CrmBillingProvider?
  providerRef    String?                   @map("provider_ref")
  rawResponse    Json?                     @map("raw_response")
  initiatedAt    DateTime?                 @map("initiated_at")
  paidAt         DateTime?                 @map("paid_at")
  voidedAt       DateTime?                 @map("voided_at")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  @@index([subscriptionId, createdAt])
  @@index([status, initiatedAt])
  @@map("subscription_invoices")
}

enum CrmAuditAction {
  INVITE_SENT
  INVITE_REVOKED
  INVITE_ACCEPTED
  MEMBER_ROLE_CHANGED
  MEMBER_STATUS_CHANGED
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_DELETED
  ORGANIZATION_RENAMED
  OWNERSHIP_TRANSFER_REQUESTED
  OWNERSHIP_TRANSFER_ACCEPTED
  OWNERSHIP_TRANSFER_DECLINED
  OWNERSHIP_TRANSFER_REVOKED
  SUBSCRIPTION_CHECKOUT_STARTED
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_CANCELED
}

enum CrmAuditOutcome {
  SUCCESS
  FAILURE
}

model CrmAuditLog {
  id                String          @id @default(uuid()) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUserId       String?         @map("actor_user_id") @db.Uuid
  actorMembershipId String?         @map("actor_membership_id") @db.Uuid
  action            CrmAuditAction
  outcome           CrmAuditOutcome @default(SUCCESS)
  targetType        String?         @map("target_type")
  targetId          String?         @map("target_id") @db.Uuid
  summary           String
  metadata          Json            @default("{}")
  ipAddress         String?         @map("ip_address")
  createdAt         DateTime        @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@map("crm_audit_logs")
}

model ImpersonationSession {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  impersonatorId String       @map("impersonator_id") @db.Uuid
  targetUserId   String       @map("target_user_id") @db.Uuid
  scope          String       @default("read")
  reason         String
  approvedById   String?      @map("approved_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  expiresAt      DateTime     @map("expires_at")
  lastSeenAt     DateTime?    @map("last_seen_at")
  revokedAt      DateTime?    @map("revoked_at")
  revokedById    String?      @map("revoked_by_id") @db.Uuid
  ipAddress      String?      @map("ip_address")
  userAgent      String?      @map("user_agent")

  @@index([organizationId, createdAt])
  @@index([impersonatorId, createdAt])
  @@map("impersonation_sessions")
}

model TenantFeatureOverride {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  enabled        Boolean
  metadata       Json         @default("{}")
  note           String?
  setByUserId    String?      @map("set_by_user_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("tenant_feature_overrides")
}

model OrgActivityRollup {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  day               DateTime     @db.Date
  contactCount      Int          @map("contact_count")
  dealCount         Int          @map("deal_count")
  ticketCount       Int          @map("ticket_count")
  activityCount     Int          @map("activity_count")
  activeMemberCount Int          @map("active_member_count")
  capturedAt        DateTime     @default(now()) @map("captured_at")

  @@unique([organizationId, day])
  @@index([day])
  @@map("org_activity_rollups")
}

model PlatformAuditLog {
  id                     String   @id @default(uuid()) @db.Uuid
  actorUserId            String   @map("actor_user_id") @db.Uuid
  onBehalfOfUserId       String?  @map("on_behalf_of_user_id") @db.Uuid
  organizationId         String?  @map("organization_id") @db.Uuid
  impersonationSessionId String?  @map("impersonation_session_id") @db.Uuid
  action                 String
  method                 String?
  path                   String?
  statusCode             Int?     @map("status_code")
  targetType             String?  @map("target_type")
  targetId               String?  @map("target_id")
  summary                String
  metadata               Json     @default("{}")
  ipAddress              String?  @map("ip_address")
  createdAt              DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([impersonationSessionId, createdAt])
  @@map("platform_audit_logs")
}

enum ContactLifecycleStage {
  LEAD
  QUALIFIED
  CUSTOMER
  PARTNER
  OTHER
}

model Contact {
  id                String                @id @default(uuid()) @db.Uuid
  organizationId    String                @map("organization_id") @db.Uuid
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  email             String?
  phone             String?
  company           String?
  jobTitle          String?               @map("job_title")
  lifecycleStage    ContactLifecycleStage @default(LEAD) @map("lifecycle_stage")
  source            String?
  tags              String[]              @default([])
  notes             String?
  linkedUserId      String?               @map("linked_user_id") @db.Uuid
  linkedUser        User?                 @relation("ContactLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  ownerMembershipId String?               @map("owner_membership_id") @db.Uuid
  ownerMembership   Membership?           @relation("ContactOwnerMembership", fields: [ownerMembershipId], references: [id], onDelete: SetNull)
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  @@unique([organizationId, email])
  @@index([organizationId, createdAt])
  @@index([organizationId, lifecycleStage])
  @@map("contacts")
}

model Membership {
  id                   String           @id @default(uuid()) @db.Uuid
  userId               String           @map("user_id") @db.Uuid
  organizationId       String           @map("organization_id") @db.Uuid
  roleId               String           @map("role_id") @db.Uuid
  status               MembershipStatus @default(ACTIVE)
  isPlatformSuperAdmin Boolean          @default(false) @map("is_platform_super_admin")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  ownershipTransfersSent     OwnershipTransferRequest[] @relation("OwnershipTransferFrom")
  ownershipTransfersReceived OwnershipTransferRequest[] @relation("OwnershipTransferTo")
  ownedDeals                 Deal[]                     @relation("DealOwnerMembership")
  crmActivitiesAuthored      CrmActivity[]              @relation("CrmActivityAuthor")
  crmTasksAssigned           CrmTask[]                  @relation("CrmTaskAssignee")
  crmTasksCreated            CrmTask[]                  @relation("CrmTaskCreatedBy")
  crmTicketsAssigned         CrmTicket[]                @relation("CrmTicketAssignee")
  crmTicketsCreated          CrmTicket[]                @relation("CrmTicketCreatedBy")
  crmTicketCommentsAuthored  CrmTicketComment[]         @relation("CrmTicketCommentAuthor")
  ownedContacts              Contact[]                  @relation("ContactOwnerMembership")

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

enum MembershipStatus {
  ACTIVE
  DEACTIVATED
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  isBuiltIn      Boolean  @default(false) @map("is_built_in")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]
  permissions  RolePermission[]
  invites      OrganizationInvite[]

  @@unique([organizationId, name])
  @@map("roles")
}

model Permission {
  key   String @id
  label String
  group String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model PlatformNavAccess {
  id                    String   @id @default(uuid()) @db.Uuid
  hiddenNavKeys         String[] @map("hidden_nav_keys")
  updatedByMembershipId String?  @map("updated_by_membership_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("platform_nav_access")
}

model OrganizationInvite {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String
  roleId         String    @map("role_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  revokedAt      DateTime? @map("revoked_at")
  invitedById    String    @map("invited_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])
  invitedBy    User         @relation("OrganizationInviteSender", fields: [invitedById], references: [id])

  @@index([organizationId])
  @@index([email])
  @@map("organization_invites")
}

model OwnershipTransferRequest {
  id                             String    @id @default(uuid()) @db.Uuid
  organizationId                 String    @map("organization_id") @db.Uuid
  fromMembershipId               String    @map("from_membership_id") @db.Uuid
  toMembershipId                 String    @map("to_membership_id") @db.Uuid
  removeSenderMembershipOnAccept Boolean   @default(false) @map("remove_sender_membership_on_accept")
  expiresAt                      DateTime  @map("expires_at")
  acceptedAt                     DateTime? @map("accepted_at")
  declinedAt                     DateTime? @map("declined_at")
  revokedAt                      DateTime? @map("revoked_at")
  createdAt                      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromMembership Membership   @relation("OwnershipTransferFrom", fields: [fromMembershipId], references: [id], onDelete: Cascade)
  toMembership   Membership   @relation("OwnershipTransferTo", fields: [toMembershipId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([toMembershipId])
  @@map("ownership_transfer_requests")
}

model ImageProcessingAsset {
  id                   String                      @id @default(uuid()) @db.Uuid
  ownerId              String                      @map("owner_id") @db.Uuid
  owner                User                        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  checksum             String
  priorityTier         ImageProcessingPriorityTier @map("priority_tier")
  qualityTier          ImageProcessingQualityTier  @map("quality_tier")
  status               ImageProcessingStatus       @default(PENDING)
  tempStorageKey       String                      @map("temp_storage_key")
  tempFileCleanedUp    Boolean                     @default(false) @map("temp_file_cleaned_up")
  originalStorageKey   String?                     @map("original_storage_key")
  resizedVariants      Json?                       @map("resized_variants")
  encodedVariants      Json?                       @map("encoded_variants")
  thumbnailStorageKey  String?                     @map("thumbnail_storage_key")
  lqip                 String?
  optimizeCompletedAt  DateTime?                   @map("optimize_completed_at")
  thumbnailCompletedAt DateTime?                   @map("thumbnail_completed_at")
  errorMessage         String?                     @map("error_message")
  createdAt            DateTime                    @default(now()) @map("created_at")
  updatedAt            DateTime                    @updatedAt @map("updated_at")

  @@unique([ownerId, checksum])
  @@index([status])
  @@map("image_processing_assets")
}

enum ImageProcessingPriorityTier {
  PAID_CREATOR
  STANDARD
  BULK_ADMIN
}

enum ImageProcessingQualityTier {
  STANDARD
  HERO
}

enum ImageProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SupportCategory {
  ORDER_ISSUE
  PAYMENT
  RETURN_REFUND
  DELIVERY
  ACCOUNT_ACCESS
  CREATOR_PROGRAM
  BRAND_PARTNER
  REPORT_CONTENT
  FEEDBACK
  OTHER
}

enum SupportStatus {
  NEW
  OPEN
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportSegment {
  SHOPPER
  CREATOR
  BRAND
  GUEST
}

enum SupportAuthorKind {
  REQUESTER
  STAFF
  SYSTEM
}

enum SupportVisibility {
  PUBLIC
  INTERNAL
}

model SupportTicket {
  id               String          @id @default(uuid()) @db.Uuid
  ticketNumber     Int             @unique @default(autoincrement()) @map("ticket_number")
  requesterUserId  String?         @map("requester_user_id") @db.Uuid
  requesterUser    User?           @relation("SupportTicketRequester", fields: [requesterUserId], references: [id], onDelete: SetNull)
  requesterEmail   String          @map("requester_email")
  requesterName    String          @map("requester_name")
  emailVerifiedAt  DateTime?       @map("email_verified_at")
  segment          SupportSegment  @default(GUEST)
  category         SupportCategory
  subject          String
  status           SupportStatus   @default(NEW)
  priority         SupportPriority @default(NORMAL)
  assigneeUserId   String?         @map("assignee_user_id") @db.Uuid
  assigneeUser     User?           @relation("SupportTicketAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  relatedOrderId   String?         @map("related_order_id") @db.Uuid
  relatedOrder     Order?          @relation(fields: [relatedOrderId], references: [id], onDelete: SetNull)
  relatedBrandId   String?         @map("related_brand_id") @db.Uuid
  relatedBrand     Brand?          @relation(fields: [relatedBrandId], references: [id], onDelete: SetNull)
  firstRespondedAt DateTime?       @map("first_responded_at")
  resolvedAt       DateTime?       @map("resolved_at")
  lastCustomerAt   DateTime?       @map("last_customer_at")
  reopenTokenHash  String?         @map("reopen_token_hash")
  sourceIp         String?         @map("source_ip")
  userAgent        String?         @map("user_agent")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  messages SupportMessage[]

  @@index([status, createdAt])
  @@index([assigneeUserId, status])
  @@index([requesterUserId])
  @@index([category, status])
  @@index([subject(ops: raw("gin_trgm_ops"))], type: Gin, map: "support_tickets_subject_trgm_idx")
  @@map("support_tickets")
}

model SupportMessage {
  id             String            @id @default(uuid()) @db.Uuid
  ticketId       String            @map("ticket_id") @db.Uuid
  ticket         SupportTicket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorKind     SupportAuthorKind @map("author_kind")
  authorUserId   String?           @map("author_user_id") @db.Uuid
  authorUser     User?             @relation("SupportMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  visibility     SupportVisibility @default(PUBLIC)
  body           String
  attachmentUrls String[]          @default([]) @map("attachment_urls")
  emailMessageId String?           @map("email_message_id")
  createdAt      DateTime          @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

model PushSubscription {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint     String       @unique
  p256dhKey    String       @map("p256dh_key")
  authKey      String       @map("auth_key")
  platform     PushPlatform  @default(OTHER)
  userAgent    String?      @map("user_agent")
  failureCount Int          @default(0) @map("failure_count")
  disabledAt   DateTime?    @map("disabled_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  lastSeenAt   DateTime     @default(now()) @map("last_seen_at")

  @@index([userId, disabledAt])
  @@map("push_subscriptions")
}

enum PushPlatform {
  ANDROID
  IOS
  DESKTOP
  OTHER
}
