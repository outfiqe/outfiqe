enum XpActivityType {
  LOOK_CREATED
  LOOK_LIKE_RECEIVED
  LOOK_COMMENT_RECEIVED
  LOOK_COMMENTED
  LOOK_SAVED
  USER_FOLLOWED
  PRODUCT_PURCHASED
  SALE_GENERATED
  PRODUCT_TAGGED
  FOLLOWER_MILESTONE
  ACHIEVEMENT_UNLOCKED
  ADMIN_ADJUSTMENT
}

enum XpTransactionStatus {
  APPLIED
  REVERSED
}

/**
 * Append-only audit ledger (spec 07). Every XP change — automatic or manual —
 * gets a row here; UserProgress.totalXp is the denormalized running sum kept
 * in sync at write time, never recomputed by summing this table on read.
 */
model XpTransaction {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityType    XpActivityType      @map("activity_type")
  amount          Int
  relatedEntityId String?             @map("related_entity_id") @db.Uuid
  source          String
  metadata        Json?
  status          XpTransactionStatus @default(APPLIED)
  createdAt       DateTime            @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, activityType, relatedEntityId])
  @@map("xp_transactions")
}

/**
 * Spec 40 — admin-tunable per-activity XP economy. The anti-abuse knobs
 * (spec 06) live here per-activity rather than a separate table: a daily cap,
 * a cooldown, and a max-times-per-entity are all scoped to one activity type.
 */
model ActivityXpConfig {
  activityType    XpActivityType @id @map("activity_type")
  enabled         Boolean        @default(true)
  xpAmount        Int            @map("xp_amount")
  dailyLimit      Int?           @map("daily_limit")
  cooldownSeconds Int?           @map("cooldown_seconds")
  maxPerEntity    Int?           @map("max_per_entity")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@map("activity_xp_configs")
}

enum BadgeCategory {
  BEGINNER
  CREATOR
  COMMUNITY
  ENGAGEMENT
  COMMERCE
  SPECIAL
}

enum BadgeRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  EXCLUSIVE
}

/**
 * designConfig/requirementConfig are validated at the service boundary via a
 * Zod schema — see badges.schemas.ts — never trusted as `any` past that point.
 */
model Badge {
  id              String        @id @default(uuid()) @db.Uuid
  name            String
