{
  "name": "@outfiqe/admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-routes.mjs",
    "build": "tsc -b && vite build",
    "pretypecheck": "node scripts/generate-routes.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "db:generate": "echo 'no database in admin app'"
  },
  "dependencies": {
    "@outfiqe/client": "workspace:*",
    "@outfiqe/components": "workspace:*",
    "@outfiqe/design-system": "workspace:*",
    "@outfiqe/error-boundary": "workspace:*",
    "@outfiqe/hooks": "workspace:*",
    "@outfiqe/types": "workspace:*",
    "@outfiqe/utils": "workspace:*",
    "@sentry/react": "^10.70.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.24",
    "lucide-react": "^1.29.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-generator": "^1.167.26",
    "@tanstack/router-plugin": "^1.168.28",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^27.0.0",
    "msw": "^2.11.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
