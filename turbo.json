{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "db:generate": {
      "cache": false,
      "inputs": ["prisma/schema.prisma"],
      "env": ["DATABASE_URL"]
    },
    "dev": {
      "dependsOn": ["db:generate"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "env": [
        "DATABASE_URL",
        "JWT_SECRET",
        "API_URL",
        "SITE_URL",
        "NEXT_PUBLIC_ADMIN_URL",
        "ADMIN_ORIGIN_URL",
        "ALLOWED_ORIGINS",
        "VITE_API_URL",
        "VITE_WEB_URL"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["db:generate"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["coverage/**"],
      "cache": true,
      "env": ["DATABASE_URL", "TEST_DATABASE_URL", "REDIS_URL", "JWT_SECRET"]
    },
    "test:unit": {
      "dependsOn": ["db:generate"],
      "outputs": ["coverage/**"],
      "cache": true
    },
    "test:integration": {
      "dependsOn": ["db:generate"],
      "outputs": ["coverage/**"],
      "cache": false,
      "env": ["DATABASE_URL", "TEST_DATABASE_URL", "REDIS_URL", "JWT_SECRET"]
    }
  }
}
